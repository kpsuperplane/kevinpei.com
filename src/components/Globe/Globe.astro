---
import { Image } from "astro:assets";
import kevin from "./Kevin.jpg";
---

<div id="globe">
  <canvas id="globe:canvas"></canvas>
  <div id="globe:html">
    <div id="globe:html:kevin">
      <div class="marker"><Image src={kevin} alt="Kevin Pei" /></div>
    </div>
  </div>
</div>

<style>
  #globe {
    opacity: 0;
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
  }
  #globe\:canvas,
  #globe\:html {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .marker {
    transform: translate3d(0, -50%, 0);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.15));
    > img {
      height: 48px;
      width: 48px;
      border-radius: 100%;
      border: 4px solid white;
    }
    &:after {
      margin-top: -8px;
      width: 0;
      height: 0;
      border-left: 16px solid transparent;
      border-right: 16px solid transparent;
      border-top: 16px solid white;
      content: "";
      display: block;
      position: relative;
      z-index: -1;
    }
  }
</style>

<script>
  import * as THREE from "three";
  import ThreeGlobe from "three-globe";
  import { CSS2DRenderer } from "three/addons/renderers/CSS2DRenderer.js";
  import countries from "./ne_110m_admin_0_countries.json";
  import GlobeAnimationManager from "./GlobeAnimationManager";
  import { getPosition, type Coordinate } from "./GlobeAnimation";

  type Marker = {
    lat: number;
    lng: number;
    element: HTMLElement;
  };

  const waterloo = {
    lat: 43.4643,
    lng: -80.5204,
  };
  const seattle = {
    lat: 47.6061,
    lng: -122.3328,
  };

  function getKevin(c: Coordinate): Marker {
    return {
      ...c,
      element: document.getElementById("globe:html:kevin")!!,
    };
  }

  // Initialize the globe
  const globe = new ThreeGlobe({ animateIn: false })
    .atmosphereColor("rgb(220, 220, 220)")
    .globeMaterial(
      new THREE.MeshLambertMaterial({ color: "rgb(209, 241, 255)" })
    )
    .hexPolygonsData(countries.features)
    .hexPolygonResolution(3)
    .hexPolygonMargin(0.1)
    .hexPolygonUseDots(true)
    .hexPolygonColor(() => "rgb(255, 255, 255)")
    .htmlElementsData([getKevin(waterloo)])
    .htmlTransitionDuration(0)
    .htmlElement("element");
  // Setup globe renderer
  const globeRenderer = new THREE.WebGLRenderer({
    canvas: document.getElementById("globe:canvas") as HTMLCanvasElement,
  });
  globeRenderer.setClearColor(0x000000, 1);

  // Setup HTML renderer
  const htmlRenderer = new CSS2DRenderer({
    element: document.getElementById("globe:html")!!,
  });

  // Setup scene
  const scene = new THREE.Scene();
  scene.add(globe);
  scene.add(new THREE.AmbientLight(0xeeeeee, Math.PI));
  const directionalLight = new THREE.DirectionalLight(0xffffff, 0.3 * Math.PI);
  directionalLight.position.set(-1, 1, 0);
  scene.add(directionalLight);

  // Setup camera
  const camera = new THREE.PerspectiveCamera();
  camera.position.z = 140;

  const render = () => {
    globe.setPointOfView(camera);
    globeRenderer.render(scene, camera);
    htmlRenderer.render(scene, camera);
  };

  const onResize = () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    globeRenderer.setPixelRatio(window.devicePixelRatio);
    globeRenderer.setSize(window.innerWidth, window.innerHeight);
    htmlRenderer.setSize(window.innerWidth, window.innerHeight);
    render();
  };

  onResize();
  window.addEventListener("resize", onResize);

  const animationManager = new GlobeAnimationManager(globe, render);

  function toRad(degrees: number) {
    return degrees * (Math.PI / 180);
  }

  globe.onGlobeReady(() => {
    setTimeout(() => {
      render();
      document
        .getElementById("globe")!
        .animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 500,
          fill: "forwards",
        });
      animationManager.animate({lat: toRad(waterloo.lat), lng: toRad(waterloo.lng)}).then(() => {
        animationManager.animate({lat: toRad(seattle.lat), lng: toRad(seattle.lng)}, (progress) => {
          globe.htmlElementsData([
            getKevin(getPosition(waterloo, seattle, progress)),
          ]);
        }).then(() => {
          globe.htmlElementsData([getKevin(seattle)]);
          render();
        });
      });
    }, 100);
  });
</script>
