---
import signatureImage from '../assets/kevin-signature.png';

interface Props {
  revealAbovePlayer?: boolean;
  revealAboveMobileNav?: boolean;
}

const { revealAbovePlayer = false, revealAboveMobileNav = false } = Astro.props;
---

<footer
  class="signature-footer"
  data-signature-footer
  data-reveal-above-player={revealAbovePlayer ? '' : undefined}
  data-reveal-above-mobile-nav={revealAboveMobileNav ? '' : undefined}
>
  <img
    class="signature"
    src={signatureImage.src}
    width="237"
    height="237"
    alt="Kevin Pei's signature"
    loading="lazy"
    decoding="async"
  />
</footer>

<script>
  const footer = document.querySelector<HTMLElement>('[data-signature-footer]');
  const signature = footer?.querySelector<HTMLElement>('.signature');
  const playerBar = document.getElementById('secondary-bar');
  const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
  const mobileQuery = window.matchMedia('(max-width: 550px)');

  if (footer && signature) {
    const controller = new AbortController();
    const resizeObserver = new ResizeObserver(scheduleCheck);
    let frameId = 0;

    function isVisible(element: HTMLElement): boolean {
      const rect = element.getBoundingClientRect();
      return getComputedStyle(element).display !== 'none' && rect.height > 0;
    }

    function getRevealThreshold(): HTMLElement | null {
      if (playerBar?.classList.contains('has-nowplaying') && isVisible(playerBar)) {
        return playerBar;
      }

      const shouldUseMobileNav = footer.hasAttribute('data-reveal-above-mobile-nav')
        && mobileQuery.matches
        && mobileNav
        && isVisible(mobileNav);

      return shouldUseMobileNav ? mobileNav : null;
    }

    function checkPosition(): void {
      frameId = 0;
      const threshold = getRevealThreshold();

      if (!threshold) {
        footer.classList.remove('is-reveal-ready');
        return;
      }

      footer.classList.add('is-reveal-ready');

      const signatureBottom = signature.getBoundingClientRect().bottom;
      const thresholdTop = threshold.getBoundingClientRect().top;

      if (signatureBottom > thresholdTop) return;

      footer.classList.add('is-visible');
      controller.abort();
      resizeObserver.disconnect();
    }

    function scheduleCheck(): void {
      if (frameId) return;
      frameId = requestAnimationFrame(checkPosition);
    }

    window.addEventListener('scroll', scheduleCheck, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener('resize', scheduleCheck, { signal: controller.signal });
    mobileQuery.addEventListener('change', scheduleCheck, { signal: controller.signal });
    if (playerBar) resizeObserver.observe(playerBar);
    if (mobileNav) resizeObserver.observe(mobileNav);
    resizeObserver.observe(signature);
    scheduleCheck();
  }
</script>

<style>
  .signature-footer {
    display: flex;
    justify-content: center;
    padding:
      30px
      var(--page-gutter)
      var(--space-5);
  }

  .signature {
    display: block;
    width: 64px;
    height: auto;
  }

  .signature-footer[data-reveal-above-player] .signature {
    opacity: 0;
  }

  .signature-footer.is-reveal-ready .signature {
    transition: opacity 300ms var(--ease-out);
  }

  .signature-footer.is-visible .signature {
    opacity: 1;
  }

  @media (max-width: 550px) {
    .signature-footer[data-reveal-above-mobile-nav] .signature {
      opacity: 0;
    }

    .signature-footer.is-visible .signature {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-footer.is-reveal-ready .signature {
      transition: none;
    }
  }
</style>
