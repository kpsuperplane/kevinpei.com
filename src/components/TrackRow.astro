---
interface Props {
  index: number;
  title: string;
  tags: string[];
  readTime: number;
  slug: string;
  active?: boolean;
  description?: string;
}
const { index, title, tags, readTime, slug, active = false, description } = Astro.props;
---

<li class:list={['track-row', { active }]}>
  <a href={`/posts/${slug}`} aria-current={active ? 'true' : undefined}>
    <span class="track-num">
      {active
        ? <span class="equalizer" role="img" aria-label="Now playing"><span/><span/><span/></span>
        : index
      }
    </span>
    <span class="track-info">
      <span class="track-title truncate">{title}</span>
      {description && <span class="track-desc truncate">{description}</span>}
    </span>
    <span class="track-category truncate">{tags.join(', ')}</span>
    <span class="track-duration">{readTime} min</span>
  </a>
</li>

<style>
  .track-row a {
    display: grid;
    grid-template-columns: var(--grid-cols-track);
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 6px;
    transition: background 0.1s;
    cursor: pointer;
  }

  .track-row a:hover {
    background: var(--bg-hover);
  }

  .track-row.active a {
    background: var(--bg-selected);
  }

  .track-num {
    font-size: var(--text-md);
    color: var(--text-muted);
    text-align: right;
    padding-right: 8px;
    font-variant-numeric: tabular-nums;
  }

  .track-row.active .track-num {
    color: var(--accent);
  }

  .track-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .track-title {
    font-size: var(--text-md);
    font-weight: 400;
    color: var(--text);
  }

  .track-row.active .track-title {
    color: var(--accent);
  }

  .track-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .track-category {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .track-duration {
    font-size: var(--text-base);
    color: var(--text-muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* Animated equalizer bars for the active/playing track */
  .equalizer {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .equalizer span {
    display: block;
    width: 3px;
    background: var(--accent);
    border-radius: 1px;
  }

  .equalizer span:nth-child(1) { height: 60%; }
  .equalizer span:nth-child(2) { height: 100%; }
  .equalizer span:nth-child(3) { height: 40%; }

  @media (prefers-reduced-motion: no-preference) {
    .equalizer span {
      animation: equalize 1.2s ease-in-out infinite;
    }

    .equalizer span:nth-child(1) { animation-delay: 0s; }
    .equalizer span:nth-child(2) { animation-delay: 0.2s; }
    .equalizer span:nth-child(3) { animation-delay: 0.4s; }
  }

  @keyframes equalize {
    0%, 100% { transform: scaleY(1); }
    50%       { transform: scaleY(0.3); }
  }

  @media (max-width: 768px) {
    .track-row a {
      grid-template-columns: var(--grid-cols-track-mobile);
      padding: 8px 16px;
    }

    .track-category {
      display: none;
    }
  }
</style>
