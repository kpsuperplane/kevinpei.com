---
interface Props {
  Content: any;
  title?: string;
  description?: string;
  date?: Date;
  readTime?: number;
}
const { Content, title, description, date, readTime } = Astro.props;

const formattedDate = date?.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-view">
  {(title || description || date || readTime) && (
    <header class="post-header">
      {title && <h1 class="post-title" data-page-stage="lead">{title}</h1>}
      {description && (
        <p class="post-description" data-page-stage="details">
          {description}
          {date && formattedDate && (
            <>
              <span class="post-meta-separator" aria-hidden="true"> · </span>
              <time datetime={date.toISOString()}>{formattedDate}</time>
            </>
          )}
        </p>
      )}
      {!description && date && formattedDate && (
        <time class="post-date" datetime={date.toISOString()} data-page-stage="details">
          {formattedDate}
        </time>
      )}
    </header>
  )}

  <div data-page-stage="body">
    {(title || description || date || readTime) && <hr class="post-header-rule" />}

    <div class="post-body">
      <Content />
    </div>
  </div>
</article>

<script>
  function updateScrollState(wrapper: HTMLElement, scroller: HTMLElement): void {
    const maxScroll = scroller.scrollWidth - scroller.clientWidth;
    const hasOverflow = maxScroll > 1;

    wrapper.toggleAttribute('data-overflow-left', hasOverflow && scroller.scrollLeft > 1);
    wrapper.toggleAttribute('data-overflow-right', hasOverflow && scroller.scrollLeft < maxScroll - 1);
    if (hasOverflow) {
      scroller.setAttribute('tabindex', '0');
    } else {
      scroller.removeAttribute('tabindex');
    }
  }

  function maskEdgesBehindLabels(diagram: HTMLElement, maskId: string): void {
    const svg = diagram.querySelector('svg.pele-flowchart');
    const edges = svg?.querySelector('.pele-edges');
    const labels = svg?.querySelectorAll<SVGTextElement>('.pele-edge-label > text');
    if (!svg || !edges || !labels?.length) return;

    const mask = document.createElementNS(svg.namespaceURI, 'mask');
    mask.id = maskId;
    mask.setAttribute('maskUnits', 'userSpaceOnUse');

    const visible = document.createElementNS(svg.namespaceURI, 'rect');
    visible.setAttribute('width', '100%');
    visible.setAttribute('height', '100%');
    visible.setAttribute('fill', 'white');
    mask.append(visible);

    for (const label of labels) {
      const { x, y, width, height } = label.getBBox();
      const gap = document.createElementNS(svg.namespaceURI, 'rect');
      gap.setAttribute('x', String(x - 3));
      gap.setAttribute('y', String(y - 2));
      gap.setAttribute('width', String(width + 6));
      gap.setAttribute('height', String(height + 4));
      gap.setAttribute('fill', 'black');
      mask.append(gap);
    }

    svg.prepend(mask);
    edges.setAttribute('mask', `url(#${maskId})`);
  }

  const mermaidBlocks = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('.post-body pre')).filter((block) => (
      block.matches('pre[data-language="mermaid"]') ||
      block.querySelector('code.language-mermaid')
    )),
  );
  const overflowBlocks = Array.from(
    document.querySelectorAll<HTMLElement>('.post-body > pre, .post-body > table'),
  ).filter((block) => !mermaidBlocks.has(block));

  const overflowEntries = overflowBlocks.map((block) => {
    const wrapper = document.createElement('div');
    wrapper.className = `post-overflow post-overflow-${block.tagName.toLowerCase()}`;
    block.classList.add('post-overflow-scroll');
    block.replaceWith(wrapper);
    wrapper.append(block);

    updateScrollState(wrapper, block);
    block.addEventListener('scroll', () => updateScrollState(wrapper, block), { passive: true });

    return { wrapper, scroller: block };
  });

  if (mermaidBlocks.size > 0) {
    const { mountAsync } = await import('pele/lazy');

    await Promise.all(Array.from(mermaidBlocks, async (block, index) => {
      const lines = Array.from(block.querySelectorAll<HTMLElement>('.line'));
      const source = lines.length > 0
        ? lines.map((line) => line.textContent ?? '').join('\n')
        : block.textContent ?? '';
      const diagram = document.createElement('div');
      diagram.className = 'mermaid-diagram';
      block.replaceWith(diagram);

      try {
        await mountAsync(diagram, source, {
          onRender: () => maskEdgesBehindLabels(diagram, `diagram-label-mask-${index}`),
        });
      } catch (error) {
        diagram.replaceWith(block);
        console.error(error);
      }
    }));
  }

  if (overflowEntries.length > 0) {
    window.addEventListener('resize', () => {
      overflowEntries.forEach(({ wrapper, scroller }) => updateScrollState(wrapper, scroller));
    });
  }
</script>

<style>
  .post-view {
    min-width: 0;
    padding-block-end: var(--space-10);
  }

  .post-header {
    margin-block-end: var(--space-5);
  }

  .post-header-rule {
    border: none;
    border-top: var(--border-width) solid color-mix(in srgb, var(--color-border) 55%, transparent);
    margin: 0 0 var(--space-6);
  }

  .post-title {
    font-size: var(--text-5xl);
    line-height: var(--leading-heading);
    margin-block-end: var(--space-3);
    color: var(--color-text);
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    text-wrap: var(--text-wrap-prose);
    margin-block-end: var(--space-4);
  }

  .post-meta-separator {
    color: color-mix(in srgb, var(--color-text-muted) 60%, transparent);
  }

  .post-date {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  /* Prose styles */
  .post-body {
    min-width: 0;
    max-width: 100%;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .post-body > :global(h2) {
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin: var(--space-8) 0 var(--space-3);
  }

  .post-body > :global(h3) {
    font-size: var(--text-xl);
    color: var(--color-text);
    margin: var(--space-6) 0 var(--space-2-5);
  }

  .post-body > :global(p) {
    margin-block-end: var(--space-5);
    text-wrap: var(--text-wrap-prose);
  }

  .post-body :global(strong) {
    font-weight: 600;
  }

  .post-body :global(a) {
    position: relative;
    color: var(--color-link);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .post-body :global(a::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 2px;
    background: var(--color-link-underline);
    border-radius: var(--radius-pill);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .post-body :global(a:hover),
  .post-body :global(a:focus-visible) {
    color: var(--color-text);
  }

  .post-body :global(a:hover::after),
  .post-body :global(a:focus-visible::after) {
    background: var(--color-accent);
  }

  .post-body > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-6) 0;
    border-radius: var(--radius-s);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface-selected);
    padding: 2px 5px;
    border-radius: var(--radius-s);
  }

  .post-body > :global(pre),
  .post-body :global(.post-overflow-pre > pre) {
    background: var(--color-code-surface) !important;
    border: var(--border-width) solid var(--color-code-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    overflow-x: auto;
    margin-block-end: var(--space-5);
  }

  .post-body :global(.post-overflow) {
    --scrim-bg: var(--color-canvas);
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .post-body :global(.post-overflow-pre) {
    --scrim-bg: var(--color-code-surface);
    border-radius: var(--radius-lg);
    margin-block-end: var(--space-5);
  }

  .post-body :global(.post-overflow-table) {
    margin: var(--space-6) 0;
  }

  .post-body :global(.post-overflow > .post-overflow-scroll) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  .post-body :global(.post-overflow-pre > pre) {
    margin-block-end: 0;
  }

  .post-body :global(.mermaid-diagram) {
    --pele-bg: #fffdf7;
    --pele-fg: var(--color-text);
    --pele-muted: var(--color-text-muted);
    --pele-line: #1f1f1f;
    --pele-surface: #fff9db;
    --pele-surface-alt: #e7f5ff;
    --pele-border: var(--pele-line);
    --pele-accent: var(--color-accent-text);
    --pele-critical: var(--color-alert-caution);
    --pele-error: var(--color-alert-caution);
    --pele-font: var(--font-sans);
    --pele-font-mono: var(--font-mono);
    margin-block-end: var(--space-5);
  }

  .post-body :global(.mermaid-diagram > svg) {
    display: block;
    margin-inline: auto;
  }

  .post-body :global(.pele-flowchart .pele-node > :is(rect, circle, ellipse, polygon, path)),
  .post-body :global(.pele-flowchart .pele-cluster > rect),
  .post-body :global(.pele-flowchart .pele-edges) {
    stroke-width: 1.35;
  }

  .post-body :global(.pele-flowchart .pele-shape-hex > polygon) {
    fill: #f8f0fc;
  }

  .post-body :global(.pele-flowchart .pele-edge-labels) {
    font-size: 16px;
  }

  .post-body :global(.pele-flowchart .pele-edge-label > rect) {
    fill: none;
  }

  .post-body :global(.post-overflow::before),
  .post-body :global(.post-overflow::after) {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 80px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .post-body :global(.post-overflow::before) {
    left: -6px;
    background: linear-gradient(
      90deg,
      var(--scrim-bg) 0%,
      color-mix(in srgb, var(--scrim-bg) 98%, transparent) 12%,
      color-mix(in srgb, var(--scrim-bg) 92%, transparent) 26%,
      color-mix(in srgb, var(--scrim-bg) 78%, transparent) 42%,
      color-mix(in srgb, var(--scrim-bg) 52%, transparent) 62%,
      color-mix(in srgb, var(--scrim-bg) 22%, transparent) 82%,
      transparent 100%
    );
  }

  .post-body :global(.post-overflow::after) {
    right: -6px;
    background: linear-gradient(
      270deg,
      var(--scrim-bg) 0%,
      color-mix(in srgb, var(--scrim-bg) 98%, transparent) 12%,
      color-mix(in srgb, var(--scrim-bg) 92%, transparent) 26%,
      color-mix(in srgb, var(--scrim-bg) 78%, transparent) 42%,
      color-mix(in srgb, var(--scrim-bg) 52%, transparent) 62%,
      color-mix(in srgb, var(--scrim-bg) 22%, transparent) 82%,
      transparent 100%
    );
  }

  .post-body :global(.post-overflow[data-overflow-left]::before),
  .post-body :global(.post-overflow[data-overflow-right]::after) {
    opacity: 1;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: var(--text-base);
    font-weight: 500;
  }

  .post-body > :global(table),
  .post-body :global(.post-overflow-table > table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    margin: var(--space-6) 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    scrollbar-width: thin;
  }

  .post-body :global(.post-overflow-table > table) {
    margin: 0;
  }

  .post-body :global(th),
  .post-body :global(td) {
    min-width: 120px;
    padding: var(--space-2-5) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .post-body :global(th) {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .post-body :global(td) {
    color: var(--color-text-muted);
  }

  .post-body :global(tbody tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--color-surface) 45%, transparent);
  }

  .post-body :global(td > :last-child),
  .post-body :global(th > :last-child) {
    margin-block-end: 0;
  }

  .post-body :global(table a) {
    white-space: normal;
  }

  .post-body > :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-inline-start: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-body > :global(.markdown-alert) {
    --alert-color: var(--color-accent-text);
    border-left: 0;
    color: var(--color-text);
    font-size: var(--text-md);
    font-style: normal;
    line-height: var(--leading-normal);
    margin: var(--space-5) 0;
    padding: var(--space-1) 0 var(--space-1) var(--space-4);
    position: relative;
  }

  .post-body > :global(.markdown-alert::before) {
    background: var(--alert-color);
    border-radius: var(--radius-pill);
    content: "";
    inset-block: 0;
    inset-inline-start: 0;
    position: absolute;
    width: 4px;
  }

  .post-body > :global(.markdown-alert-note) {
    --alert-color: var(--color-alert-note);
  }

  .post-body > :global(.markdown-alert-tip) {
    --alert-color: var(--color-alert-tip);
  }

  .post-body > :global(.markdown-alert-important) {
    --alert-color: var(--color-alert-important);
  }

  .post-body > :global(.markdown-alert-warning) {
    --alert-color: var(--color-alert-warning);
  }

  .post-body > :global(.markdown-alert-caution) {
    --alert-color: var(--color-alert-caution);
  }

  .post-body > :global(.markdown-alert > :last-child) {
    margin-block-end: 0;
  }

  .post-body :global(.markdown-alert-title) {
    color: var(--alert-color);
    display: inline;
    font-size: var(--text-md);
    font-weight: 700;
    line-height: inherit;
    margin: 0 var(--space-1-5) 0 0;
  }

  .post-body :global(.markdown-alert-title + p) {
    display: inline;
    font-weight: 500;
  }

  .post-body > :global(ul),
  .post-body > :global(ol) {
    padding-inline-start: var(--space-6);
    margin-block-end: var(--space-5);
    list-style: revert;
  }

  .post-body :global(li) {
    margin-block-end: var(--space-1-5);
  }

  .post-body > :global(hr) {
    border: none;
    border-top: var(--border-width) solid var(--color-border);
    margin: var(--space-8) 0;
  }

  @media (max-width: 480px) {
    .post-header {
      padding-block-start: var(--space-3);
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .post-view {
      padding-inline-start: 0;
    }
  }

  @media (max-width: 768px) {
    .post-view {
      padding-block-end: var(--space-8);
    }

    .post-title {
      font-size: var(--text-4xl);
    }
  }
</style>
