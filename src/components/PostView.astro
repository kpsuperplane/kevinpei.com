---
interface Props {
  Content: any;
  title?: string;
  description?: string;
  tags?: string[];
  date?: Date;
  readTime?: number;
}
const { Content, title, description, tags, date, readTime } = Astro.props;

const formattedDate = date?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-view">
  {(tags?.length || title || description || date) && (
    <header class="post-header">
      {tags?.length && (
        <div class="tag-list">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag.toLowerCase()}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
      {title && <h1 class="post-title">{title}</h1>}
      {description && <p class="post-description">{description}</p>}
      {(date || readTime) && (
        <div class="post-meta">
          {formattedDate && <span>{formattedDate}</span>}
          {formattedDate && readTime && <span class="dot">·</span>}
          {readTime && <span>{readTime} min read</span>}
        </div>
      )}
    </header>
  )}

  <div class="post-body">
    <Content />
  </div>
</article>

<style>
  .post-view {
    padding: 0px 32px 80px;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    transition: opacity 0.1s;
  }

  .tag:hover {
    opacity: 0.7;
  }

  .post-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    color: var(--text);
  }

  .post-description {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .post-meta {
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    opacity: 0.5;
  }

  /* Prose styles */
  .post-body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }

  .post-body :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    margin: 36px 0 12px;
  }

  .post-body :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin: 28px 0 10px;
  }

  .post-body :global(p) {
    margin-bottom: 20px;
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.1s;
  }

  .post-body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-selected);
    padding: 2px 5px;
    border-radius: 3px;
  }

  .post-body :global(pre) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 14px;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    margin: 24px 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 24px;
    margin-bottom: 20px;
    list-style: revert;
  }

  .post-body :global(li) {
    margin-bottom: 6px;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 40px 0;
  }

  @media (max-width: 768px) {
    .post-view {
      padding: 32px 16px 60px;
    }

    .post-title {
      font-size: 26px;
    }
  }
</style>
