---
interface Props {
  Content: any;
  title?: string;
  description?: string;
  date?: Date;
  readTime?: number;
}
const { Content, title, description, date, readTime } = Astro.props;
---

<article class="post-view">
  {(title || description || date || readTime) && (
    <header class="post-header">
      {title && <h1 class="post-title">{title}</h1>}
      {description && <p class="post-description">{description}</p>}
    </header>
  )}

  {(title || description || date || readTime) && <hr class="post-header-rule" />}

  <div class="post-body">
    <Content />
  </div>
</article>

<style>
  .post-view {
    padding: 0 var(--page-gutter) calc(var(--space-10) + var(--space-10));
  }

  .post-header {
    margin-block-end: var(--space-5);
  }

  .post-header-rule {
    border: none;
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    margin: 0 0 var(--space-6);
  }

  .post-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin-block-end: var(--space-3);
    color: var(--text);
  }

  .post-description {
    font-size: 16px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-block-end: var(--space-4);
  }

  /* Prose styles */
  .post-body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }

  .post-body > :global(h2) {
    font-size: 22px;
    font-weight: 600;
    color: var(--text);
    margin: var(--space-8) 0 var(--space-3);
  }

  .post-body > :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin: var(--space-6) 0 var(--space-2-5);
  }

  .post-body > :global(p) {
    margin-block-end: var(--space-5);
  }

  .post-body :global(a) {
    position: relative;
    color: #333333;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.1s;
  }

  .post-body :global(a::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 2px;
    background: #b8b8b8;
    border-radius: 999px;
    transition: background 0.1s;
  }

  .post-body :global(a:hover),
  .post-body :global(a:focus-visible) {
    color: var(--text);
  }

  .post-body :global(a:hover::after),
  .post-body :global(a:focus-visible::after) {
    background: var(--accent);
  }

  .post-body > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-6) 0;
    border-radius: var(--radius-md);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-selected);
    padding: 2px 5px;
    border-radius: 3px;
  }

  .post-body > :global(pre) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    overflow-x: auto;
    margin-block-end: var(--space-5);
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 14px;
  }

  .post-body > :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-inline-start: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-body > :global(ul),
  .post-body > :global(ol) {
    padding-inline-start: var(--space-6);
    margin-block-end: var(--space-5);
    list-style: revert;
  }

  .post-body :global(li) {
    margin-block-end: var(--space-1-5);
  }

  .post-body > :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-8) 0;
  }

  @media (max-width: 768px) {
    .post-view {
      padding-block-end: calc(var(--space-8) + var(--space-6));
    }

    .post-title {
      font-size: 26px;
    }
  }
</style>
