---
import { Image } from 'astro:assets';
import profilePhoto from '../assets/kevin-pei-profile.png';
import { primaryLinks, socialLinks } from '../utils/navigation';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

---

<aside class="sidebar">
  <a href="/" class="profile">
    <Image
      class="avatar"
      src={profilePhoto}
      alt="Kevin Pei"
      width={40}
      height={40}
      densities={[1.5, 2]}
      loading="eager"
      decoding="async"
    />
    <div class="profile-info">
      <span class="name">Kevin Pei</span>
      <span class="subtitle">Let’s build awesome</span>
    </div>
  </a>

  <nav>
    <ul class="nav-list">
      {primaryLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="nav-item"
            target={link.label === 'Email' ? undefined : '_blank'}
            rel={link.label === 'Email' ? undefined : 'noopener noreferrer'}
          >
            <i class:list={['nav-icon', link.icon === 'read-cv-logo' ? 'resume-icon' : ['ph-fill', `ph-${link.icon}`]]} aria-hidden="true"></i>
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <ul class="nav-list">
      {socialLinks.map(link => (
        <li>
          <a href={link.href} class="nav-item" target="_blank" rel="noopener noreferrer">
            <i class:list={['ph-fill', `ph-${link.icon}`, 'nav-icon']} aria-hidden="true"></i>
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<nav class="mobile-nav">
  <a
    href="/"
    class="mobile-profile"
    aria-current={currentPath === '/' ? 'page' : undefined}
  >
    <Image
      class="mobile-avatar"
      src={profilePhoto}
      alt=""
      width={40}
      height={40}
      densities={[1.5, 2]}
      loading="eager"
      decoding="async"
    />
    <div class="mobile-profile-info">
      <span class="mobile-name">Kevin Pei</span>
      <span class="mobile-subtitle">Let’s build awesome</span>
    </div>
  </a>
  <a
    href="/kevin-pei-resume-19-06-2026.pdf"
    class="mobile-nav-item"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Resume"
    title="Resume"
  >
    <i class="mobile-nav-icon resume-icon" aria-hidden="true"></i>
  </a>
  <button
    class="mobile-nav-item"
    id="btn-social"
    aria-label="Social"
    title="Social"
    aria-expanded="false"
    aria-controls="secondary-social-view"
  >
    <i class="ph-fill ph-address-book-tabs mobile-nav-icon" aria-hidden="true"></i>
  </button>
</nav>

<style>
  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding:
      calc(var(--space-8) + var(--space-3) + var(--safe-area-inset-top))
      var(--space-3)
      var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2) var(--space-1-5);
    border-radius: var(--radius-s);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    corner-shape: round;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .name {
    font-weight: 600;
    font-size: var(--text-md);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subtitle {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-px);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-size-sm);
    padding: var(--space-2);
    border-radius: var(--radius-s);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-item:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-surface-selected);
    color: var(--color-text);
  }

  .nav-icon {
    flex-shrink: 0;
    width: 40px;
    text-align: center;
    font-size: var(--text-2xl);
  }

  .nav-icon,
  .mobile-nav-icon {
    color: var(--icon-color);
    filter: saturate(0.75);
    transition: filter var(--duration-fast) var(--ease-standard);
  }

  .nav-item:hover .nav-icon,
  .nav-item:focus-visible .nav-icon,
  .mobile-nav-item:hover .mobile-nav-icon,
  .mobile-nav-item:focus-visible .mobile-nav-icon {
    filter: saturate(1);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .nav-icon:not(.resume-icon),
    .mobile-nav-icon:not(.resume-icon) {
      background-image: var(--icon-gradient);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  .ph-github-logo,
  .ph-threads-logo {
    --icon-color: #111111;
    --icon-gradient: linear-gradient(135deg, #111111, #6b7280);
  }

  .ph-x-logo {
    --icon-color: #111111;
    --icon-gradient: linear-gradient(135deg, #111111, #64748b);
  }

  .ph-linkedin-logo {
    --icon-color: #0a66c2;
    --icon-gradient: linear-gradient(135deg, #0a66c2, #38bdf8);
  }

  .ph-instagram-logo {
    --icon-color: #c13584;
    --icon-gradient: linear-gradient(135deg, #f9ce34, #ee2a7b 52%, #6228d7);
  }

  .ph-paper-plane-tilt {
    --icon-color: #f97316;
    --icon-gradient: linear-gradient(135deg, #ea580c, #fbbf24);
  }

  .resume-icon {
    --icon-color: #166534;
    --icon-gradient: linear-gradient(135deg, #14532d, #22c55e);
    line-height: 1;
    display: flex;
    justify-content: center;
  }

  .resume-icon::before {
    content: '';
    display: block;
    width: 1em;
    height: 1em;
    background: var(--icon-gradient);
    mask: url('/resume-cv.svg') center / contain no-repeat;
  }

  .ph-address-book-tabs {
    --icon-color: #7c3aed;
    --icon-gradient: linear-gradient(135deg, #7c3aed, #ec4899);
  }

  @media (max-width: 480px) {
    .sidebar {
      display: none;
    }
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 480px) {
    .mobile-profile {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-inline-start: 0;
      padding-inline-end: var(--space-2);
    }

    .mobile-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      corner-shape: round;
      object-fit: cover;
      flex-shrink: 0;
      outline: 1px solid oklch(0 0 0 / 0.1);
      outline-offset: -1px;
    }

    .mobile-profile-info {
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-name {
      font-weight: 600;
      font-size: var(--text-md);
      color: var(--color-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-subtitle {
      font-size: 12px;
      font-weight: 500;
      color: var(--color-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-nav {
      display: flex;
      flex-direction: row;
      gap: 0;
      position: fixed;
      bottom: var(--mobile-dock-bottom);
      left: max(var(--space-3), var(--safe-area-inset-left));
      right: max(var(--space-3), var(--safe-area-inset-right));
      height: var(--mobile-nav-h);
      padding-inline: calc(var(--space-2) - var(--border-width)) var(--space-3);
      background: var(--color-canvas);
      border: var(--border-width) solid var(--color-border);
      border-radius: calc(var(--mobile-nav-h) / 2);
      corner-shape: round;
      box-shadow: var(--shadow-mobile-dock);
      overflow: hidden;
      z-index: var(--z-mobile-nav);
    }

    .mobile-nav-item {
      flex: 0 0 calc(var(--mobile-nav-h) - var(--space-2));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: var(--text-base);
      color: var(--color-text-muted);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .mobile-nav-item.active {
      color: var(--color-text);
      font-weight: 700;
    }

    .mobile-nav-icon {
      font-size: 32px;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .sidebar {
      padding: calc(var(--space-4) + var(--safe-area-inset-top)) var(--space-2) var(--space-4);
      scrollbar-gutter: auto;
    }

    .profile {
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      text-align: center;
      padding-inline: 0;
    }

    .profile-info {
      max-width: 100%;
    }

    .subtitle {
      white-space: normal;
    }

    .name {
      white-space: normal;
    }

    .nav-item {
      flex-direction: column;
      justify-content: center;
      gap: 0;
      min-height: var(--mobile-nav-h);
      padding: var(--space-1);
    }

    .nav-icon {
      font-size: 28px;
    }

    .nav-item:hover {
      background: transparent;
    }

    .nav-item > span {
      font-size: 12px;
      line-height: 18px;
      font-weight: 500;
      color: color-mix(in srgb, var(--color-text-muted) 84%, var(--color-canvas));
      opacity: 0;
      transform: translateY(-3px);
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-base) var(--ease-out);
    }

    .nav-item:hover > span,
    .nav-item:focus-visible > span {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-item > span {
        transform: none;
        transition: none;
      }
    }
  }
</style>
