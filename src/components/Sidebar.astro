---
interface Props {
  currentPath?: string;
  tags?: string[];
}
const { currentPath = '/', tags = [] } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
];

const socialLinks = [
  { href: 'https://github.com/kpsuperplane', label: 'GitHub' },
  { href: 'https://twitter.com/kpsuperplane', label: 'Twitter' },
  { href: 'mailto:hello@kevinpei.com', label: 'Email' },
];
---

<aside class="sidebar">
  <a href="/" class="profile" style="display: flex;">
    <img class="avatar" src="https://raw.githubusercontent.com/kpsuperplane/kevinpei.com/2020/src/favicon/safari-pinned-tab.svg" alt="Kevin Pei" />
    <div class="profile-info">
      <span class="name">Kevin Pei</span>
      <span class="subtitle">Let's build awesome</span>
    </div>
  </a>

  <nav>
    <ul class="nav-list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-item', { active: currentPath === link.href }]}
          >
            <span class="nav-icon">◎</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <p class="section-label">Playlists</p>
    <ul class="nav-list">
      {tags.map(tag => (
        <li>
          <a
            href={`/tags/${tag.toLowerCase()}`}
            class:list={['nav-item', { active: currentPath === `/tags/${tag.toLowerCase()}` }]}
          >
            <span class="nav-icon">♫</span>
            {tag}
          </a>
        </li>
      ))}
    </ul>

    <p class="section-label">Social</p>
    <ul class="nav-list">
      {socialLinks.map(link => (
        <li>
          <a href={link.href} class="nav-item" target="_blank" rel="noopener noreferrer">
            <span class="nav-icon">→</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<!-- Mobile sheets -->
<div class="mobile-sheet" id="sheet-playlists">
  <div class="sheet-backdrop"></div>
  <div class="sheet-content">
    <p class="sheet-label">Playlists</p>
    <ul class="sheet-list">
      {tags.map(tag => (
        <li>
          <a href={`/tags/${tag.toLowerCase()}`} class="sheet-item">
            <span class="nav-icon">♫</span>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="mobile-sheet" id="sheet-social">
  <div class="sheet-backdrop"></div>
  <div class="sheet-content">
    <p class="sheet-label">Social</p>
    <ul class="sheet-list">
      {socialLinks.map(link => (
        <li>
          <a href={link.href} class="sheet-item" target="_blank" rel="noopener noreferrer">
            <span class="nav-icon">→</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<nav class="mobile-nav">
  <a href="/" class:list={['mobile-nav-item', { active: currentPath === '/' }]}>
    <span class="mobile-nav-icon">◎</span>
    <span>Home</span>
  </a>
  <button class="mobile-nav-item" id="btn-playlists" aria-expanded="false">
    <span class="mobile-nav-icon">♫</span>
    <span>Playlists</span>
  </button>
  <button class="mobile-nav-item" id="btn-social" aria-expanded="false">
    <span class="mobile-nav-icon">→</span>
    <span>Social</span>
  </button>
</nav>

<script>
  function initMobileNav() {
    const btnPlaylists = document.getElementById('btn-playlists');
    const btnSocial    = document.getElementById('btn-social');
    const sheetPlaylists = document.getElementById('sheet-playlists');
    const sheetSocial    = document.getElementById('sheet-social');

    function openSheet(sheet: HTMLElement, btn: HTMLElement) {
      sheet.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
      btn.classList.add('active');
    }

    function closeSheet(sheet: HTMLElement, btn: HTMLElement) {
      if (!sheet.classList.contains('open')) return;
      sheet.classList.add('closing');
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('active');
      sheet.querySelector('.sheet-content')?.addEventListener('animationend', () => {
        sheet.classList.remove('open', 'closing');
      }, { once: true });
    }

    function toggleSheet(sheet: HTMLElement, btn: HTMLElement, other: HTMLElement, otherBtn: HTMLElement) {
      if (sheet.classList.contains('open') && !sheet.classList.contains('closing')) {
        closeSheet(sheet, btn);
      } else {
        closeSheet(other, otherBtn);
        sheet.classList.remove('closing');
        openSheet(sheet, btn);
      }
    }

    btnPlaylists?.addEventListener('click', () =>
      toggleSheet(sheetPlaylists!, btnPlaylists, sheetSocial!, btnSocial!)
    );
    btnSocial?.addEventListener('click', () =>
      toggleSheet(sheetSocial!, btnSocial, sheetPlaylists!, btnPlaylists!)
    );

    // Close on backdrop click
    sheetPlaylists?.querySelector('.sheet-backdrop')?.addEventListener('click', () =>
      closeSheet(sheetPlaylists, btnPlaylists!)
    );
    sheetSocial?.querySelector('.sheet-backdrop')?.addEventListener('click', () =>
      closeSheet(sheetSocial, btnSocial!)
    );
  }

  initMobileNav();
</script>

<style>
  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding: 32px 12px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0px 8px 6px;
    border-radius: 6px;
    transition: background 0.1s;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  .name {
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subtitle {
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .section-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 8px 4px;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 6px;
    font-size: 13px;
    color: var(--text-muted);
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-item:hover {
    background: var(--bg-hover);
    color: var(--text);
  }

  .nav-item.active {
    background: var(--bg-selected);
    color: var(--text);
  }

  .nav-icon {
    flex-shrink: 0;
    width: 16px;
    text-align: center;
    font-size: 12px;
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }

  .mobile-nav,
  .mobile-sheet {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-nav {
      display: flex;
      flex-direction: row;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: var(--mobile-nav-h);
      background: var(--bg);
      border-top: 1px solid var(--border);
      z-index: 110;
    }

    .mobile-nav-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 11px;
      color: var(--text-muted);
      transition: color 0.1s;
    }

    .mobile-nav-item.active {
      color: var(--accent);
    }

    .mobile-nav-icon {
      font-size: 18px;
      line-height: 1;
    }

    /* ── Sheets ── */
    .mobile-sheet {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 105;
      pointer-events: none;
    }

    .mobile-sheet.open {
      display: block;
      pointer-events: auto;
    }

    .sheet-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.2);
    }

    .sheet-content {
      position: absolute;
      bottom: var(--mobile-nav-h);
      left: 0;
      right: 0;
      background: var(--bg);
      border-top: 1px solid var(--border);
      padding: 8px 0 4px;
      animation: sheet-up 0.2s ease;
    }

    .mobile-sheet.closing .sheet-content {
      animation: sheet-down 0.2s ease forwards;
    }

    .mobile-sheet.closing .sheet-backdrop {
      animation: fade-out 0.2s ease forwards;
    }

    @keyframes fade-out {
      from { opacity: 1; }
      to   { opacity: 0; }
    }

    @keyframes sheet-up {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }

    @keyframes sheet-down {
      from { transform: translateY(0); }
      to   { transform: translateY(100%); }
    }

    .sheet-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 16px 8px;
    }

    .sheet-list {
      display: flex;
      flex-direction: column;
    }

    .sheet-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      font-size: 15px;
      color: var(--text);
    }

    .sheet-item:active {
      background: var(--bg-hover);
    }
  }
</style>
