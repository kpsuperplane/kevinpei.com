---
import { primaryLinks, socialLinks } from '../utils/navigation';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

---

<aside class="sidebar">
  <a href="/" class="profile">
    <img class="avatar" src="/icon.png" alt="Kevin Pei" width="40" height="40" decoding="async" />
    <div class="profile-info">
      <span class="name">Kevin Pei</span>
      <span class="subtitle">Let's build awesome</span>
    </div>
  </a>

  <nav>
    <ul class="nav-list">
      {primaryLinks.map(link => (
        <li>
          <a href={link.href} class="nav-item" target="_blank" rel="noopener noreferrer">
            <i class:list={['ph-fill', `ph-${link.icon}`, 'nav-icon']} aria-hidden="true"></i>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <ul class="nav-list">
      {socialLinks.map(link => (
        <li>
          <a href={link.href} class="nav-item" target="_blank" rel="noopener noreferrer">
            <i class:list={['ph-fill', `ph-${link.icon}`, 'nav-icon']} aria-hidden="true"></i>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<nav class="mobile-nav">
  <a
    href="/"
    class="mobile-profile"
    aria-current={currentPath === '/' ? 'page' : undefined}
  >
    <img class="mobile-avatar" src="/icon.png" alt="" width="32" height="32" decoding="async" />
    <div class="mobile-profile-info">
      <span class="mobile-name">Kevin Pei</span>
      <span class="mobile-subtitle">Let's build awesome</span>
    </div>
  </a>
  <a href="/kevin-pei-resume-19-06-2026.pdf" class="mobile-nav-item" target="_blank" rel="noopener noreferrer">
    <i class="ph-fill ph-read-cv-logo mobile-nav-icon" aria-hidden="true"></i>
    <span>Resume</span>
  </a>
  <button
    class="mobile-nav-item"
    id="btn-social"
    aria-expanded="false"
    aria-controls="secondary-social-view"
  >
    <i class="ph-bold ph-at mobile-nav-icon" aria-hidden="true"></i>
    <span>Social</span>
  </button>
</nav>

<style>
  .sidebar {
    grid-area: sidebar;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    scrollbar-gutter: stable;
    padding: calc(var(--space-8) + var(--space-3)) var(--space-3) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2) var(--space-1-5);
    border-radius: var(--radius-s);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-m);
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .name {
    font-weight: 600;
    font-size: var(--text-md);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-px);
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-size-sm);
    padding: var(--space-2);
    border-radius: var(--radius-s);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-item:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .nav-item.active {
    background: var(--color-surface-selected);
    color: var(--color-text);
  }

  .nav-icon {
    flex-shrink: 0;
    width: 40px;
    text-align: center;
    font-size: var(--text-2xl);
  }

  .nav-icon,
  .mobile-nav-icon {
    color: var(--icon-color);
    filter: saturate(0.75);
    transition: filter var(--duration-fast) var(--ease-standard);
  }

  .nav-item:hover .nav-icon,
  .nav-item:focus-visible .nav-icon,
  .mobile-nav-item:hover .mobile-nav-icon,
  .mobile-nav-item:focus-visible .mobile-nav-icon {
    filter: saturate(1);
  }

  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .nav-icon,
    .mobile-nav-icon {
      background-image: var(--icon-gradient);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  .ph-github-logo,
  .ph-threads-logo {
    --icon-color: #111111;
    --icon-gradient: linear-gradient(135deg, #111111, #6b7280);
  }

  .ph-x-logo {
    --icon-color: #111111;
    --icon-gradient: linear-gradient(135deg, #111111, #64748b);
  }

  .ph-linkedin-logo {
    --icon-color: #0a66c2;
    --icon-gradient: linear-gradient(135deg, #0a66c2, #38bdf8);
  }

  .ph-instagram-logo {
    --icon-color: #c13584;
    --icon-gradient: linear-gradient(135deg, #f9ce34, #ee2a7b 52%, #6228d7);
  }

  .ph-paper-plane-tilt {
    --icon-color: #f97316;
    --icon-gradient: linear-gradient(135deg, #ea580c, #fbbf24);
  }

  .ph-read-cv-logo {
    --icon-color: #166534;
    --icon-gradient: linear-gradient(135deg, #14532d, #22c55e);
  }

  .ph-at {
    --icon-color: #7c3aed;
    --icon-gradient: linear-gradient(135deg, #7c3aed, #ec4899);
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-profile {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-inline-start: calc((var(--mobile-nav-h) - 32px) / 2);
      padding-inline-end: var(--space-2);
    }

    .mobile-avatar {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-lg);
      object-fit: cover;
      flex-shrink: 0;
    }

    .mobile-profile-info {
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    .mobile-name {
      font-weight: 600;
      font-size: var(--text-md);
      color: var(--color-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-subtitle {
      font-size: var(--text-base);
      color: var(--color-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .mobile-nav {
      display: flex;
      flex-direction: row;
      gap: 0;
      position: fixed;
      bottom: var(--mobile-dock-bottom);
      left: var(--space-3);
      right: var(--space-3);
      height: var(--mobile-nav-h);
      padding-inline: var(--space-2) var(--space-3);
      background: var(--color-canvas);
      border: var(--border-width) solid var(--color-border);
      border-radius: calc(var(--mobile-nav-h) / 2);
      corner-shape: round;
      box-shadow: var(--shadow-floating);
      overflow: hidden;
      z-index: var(--z-mobile-nav);
    }

    .mobile-nav-item {
      flex: 0 0 calc(var(--mobile-nav-h) - var(--space-2));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: var(--text-base);
      color: var(--color-text-muted);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .mobile-nav-item.active {
      color: var(--color-text);
      font-weight: 700;
    }

    .mobile-nav-icon {
      font-size: var(--text-2xl);
    }

    .mobile-nav-item > span {
      font-size: 12px;
      font-weight: 500;
      color: color-mix(in srgb, var(--color-text-muted) 84%, var(--color-canvas));
    }

  }
</style>
