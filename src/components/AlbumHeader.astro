---
interface Props {
  title: string;
  description?: string;
  playHref: string;
}

const {
  title,
  description,
  playHref,
} = Astro.props;
---

<section class="album-header" aria-labelledby="album-title">
  <div class="album-art-wrap" aria-hidden="true">
    <video
      class="album-art"
      src="/skiing.mp4"
      poster="/skiing-poster.jpg"
      autoplay
      muted
      playsinline
      preload="auto"
    ></video>
  </div>
  <div class="album-info">
    <h1 class="album-title" id="album-title">{title}</h1>
    {description && <p class="album-description">{description}</p>}
    <a class="play-button" href={playHref} aria-label="About Me">
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5v14l11-7L8 5z" fill="currentColor" />
      </svg>
      <span>About Me</span>
    </a>
  </div>
</section>

<style>
  .album-header {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-10) var(--space-8) var(--space-2);
    margin: 0 calc(-1 * var(--list-gutter));
    background: #15364a;
  }

  .album-art-wrap {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 0;
  }

  .album-art {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .album-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(21, 54, 74, 0) 0%, rgba(21, 54, 74, 0.03) 32%, rgba(21, 54, 74, 0.16) 52%, rgba(21, 54, 74, 0.5) 70%, rgba(21, 54, 74, 0.88) 84%, #15364a 96%, #15364a 100%);
    pointer-events: none;
  }

  .album-info {
    position: relative;
    z-index: 2;
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    text-align: left;
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.52);
  }

  .album-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.78);
  }

  .album-title {
    font-size: 54px;
    line-height: 1.05;
    font-weight: 800;
    color: #ffffff;
  }

  .album-description {
    width: 100%;
    max-width: none;
    font-size: var(--text-md);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-6);
    border-radius: 999px;
    background: #ffffff;
    color: #162531;
    font-size: var(--text-md);
    font-weight: 700;
    text-shadow: none;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    margin-block-start: var(--space-1);
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .play-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .play-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 768px) {
    .album-header {
      min-height: 390px;
      padding: var(--space-8) var(--space-2) var(--space-2);
      margin: 0;
    }

    .album-info {
      gap: var(--space-2);
      text-align: center;
      align-items: center;
    }

    .album-title {
      font-size: 36px;
    }

    .album-description {
      font-size: var(--text-base);
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .play-button {
      min-height: 38px;
      padding-inline: var(--space-5);
    }
  }
</style>
