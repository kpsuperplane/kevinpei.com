---
interface Props {
  title: string;
  description?: string;
  playHref: string;
}

const {
  title,
  description,
  playHref,
} = Astro.props;
---

<section class="album-header" aria-labelledby="album-title">
  <div class="album-art-wrap" aria-hidden="true">
    <video
      class="album-art"
      src="/skiing.mp4"
      poster="/skiing-poster.jpg"
      autoplay
      muted
      playsinline
      preload="auto"
    ></video>
  </div>
  <div class="album-info">
    <h1 class="album-title" id="album-title">{title}</h1>
    {description && <p class="album-description">{description}</p>}
    <a class="play-button" href={playHref} aria-label="About Me">
      <i class="ph-fill ph-play play-icon" aria-hidden="true"></i>
      <span>About Me</span>
    </a>
  </div>
</section>

<style>
  .album-header {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--space-10) var(--space-8) var(--space-2);
    margin: 0 calc(-1 * var(--list-gutter));
    background: var(--color-feature-surface);
  }

  .album-art-wrap {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 0;
  }

  .album-art {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .album-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-feature-surface) 0%, transparent) 0%,
        color-mix(in srgb, var(--color-feature-surface) 3%, transparent) 32%,
        color-mix(in srgb, var(--color-feature-surface) 16%, transparent) 52%,
        color-mix(in srgb, var(--color-feature-surface) 50%, transparent) 70%,
        color-mix(in srgb, var(--color-feature-surface) 88%, transparent) 84%,
        var(--color-feature-surface) 96%,
        var(--color-feature-surface) 100%
      );
    pointer-events: none;
  }

  .album-info {
    position: relative;
    z-index: 2;
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    text-align: left;
    color: var(--color-feature-text);
    text-shadow: var(--shadow-feature-text);
    transform: translateY(var(--space-4));
  }

  .album-label {
    font-size: var(--text-base);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: color-mix(in srgb, var(--color-feature-text) 72%, transparent);
  }

  .album-title {
    font-size: var(--text-7xl);
    line-height: var(--leading-display);
    font-weight: 600;
    color: var(--color-feature-text);
  }

  .album-description {
    width: 100%;
    max-width: none;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: color-mix(in srgb, var(--color-feature-text) 80%, transparent);
    text-wrap: pretty;
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-size-sm);
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--color-feature-text);
    color: var(--color-on-strong);
    font-size: var(--text-md);
    font-weight: 700;
    text-shadow: none;
    box-shadow: var(--shadow-feature-action);
    margin-block-start: var(--space-1);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .play-icon {
    font-size: var(--text-lg);
    flex-shrink: 0;
  }

  .play-button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-feature-action-hover);
  }

  @media (max-width: 550px) {
    .album-header {
      min-height: 390px;
      padding: var(--space-8) var(--space-5) var(--space-2);
      margin: 0;
    }

    .album-info {
      gap: var(--space-2);
      text-align: center;
      align-items: center;
    }

    .album-title {
      font-size: var(--text-5xl);
    }

    .album-description {
      font-size: var(--text-base);
      font-weight: 500;
      line-height: var(--leading-normal);
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .play-button {
      min-height: var(--control-size-sm);
      padding-inline: var(--space-5);
    }
  }
</style>
