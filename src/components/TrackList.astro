---
import TrackRow from './TrackRow.astro';
import { getReadTime } from '../utils/readTime';
import type { Post } from '../types';

type TrackListItem = {
  href: string;
  title: string;
  readTime: number;
  description?: string;
  active?: boolean;
};

interface Props {
  posts: Post[];
  pinnedTracks?: TrackListItem[];
  activeSlug?: string;
  heading?: string;
}
const { posts, pinnedTracks = [], activeSlug, heading } = Astro.props;
const trackOffset = pinnedTracks.length;

const timingDataModules = import.meta.glob<{ duration?: number }>(
  ['../content/posts/*.json', '!../content/posts/*.whisper.json'],
  { import: 'default', eager: true }
);

function getPostDuration(post: Post): number {
  const timingData = timingDataModules[`../content/posts/${post.id}.json`];
  return timingData?.duration ? timingData.duration / 60 : getReadTime(post.body ?? '');
}
---

<div class="track-list-wrap">
  <div class="track-list-header">
    {heading && <h1 class="heading">{heading}</h1>}
    <slot name="feature" />
    <div class="col-headers">
      <span class="col-num">#</span>
      <span class="col-title">Title</span>
      <span class="col-duration">Time</span>
    </div>
    <hr class="divider" />
  </div>

  <ul class="track-list">
    {pinnedTracks.map((track, i) => (
      <TrackRow
        index={i + 1}
        title={track.title}
        readTime={track.readTime}
        href={track.href}
        active={track.active}
        description={track.description}
      />
    ))}
    {posts.map((post, i) => (
      <TrackRow
        index={i + trackOffset + 1}
        title={post.data.title}
        readTime={getPostDuration(post)}
        slug={post.id}
        active={post.id === activeSlug}
        description={post.data.description}
      />
    ))}
  </ul>

  <div class="coming-soon" aria-label="More posts coming soon">
    <svg class="coming-soon-art" viewBox="0 0 160 120" width="112" height="84" role="img" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path class="steam" d="M58 28c-8-8 8-12 0-20" />
        <path class="steam" d="M80 30c-8-9 9-14 0-24" />
        <path class="steam" d="M102 28c-8-8 8-12 0-20" />
        <path class="lid" d="M46 48h68" />
        <path class="lid" d="M70 41h20" />
        <path d="M40 54h80l-7 40H47z" />
        <path d="M33 62c-12 1-12 15 2 16" />
        <path d="M127 62c12 1 12 15-2 16" />
        <path d="M52 94h56" />
        <path d="M60 104h40" />
        <path d="M124 29l16 48" />
        <path d="M132 27c6-2 11 1 12 6s-2 10-8 12" />
        <path class="spark" d="M25 34h10" />
        <path class="spark" d="M30 29v10" />
        <path class="spark" d="M131 92h10" />
        <path class="spark" d="M136 87v10" />
      </g>
    </svg>
    <p>More posts coming soon!</p>
  </div>
</div>

<style>
  .track-list-wrap {
    --text: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.7);
    --border: rgba(255, 255, 255, 0.18);
    background: #15364a;
    border-radius: var(--radius-lg);
    margin-inline: var(--page-gutter);
    padding-inline: var(--list-gutter);
    padding-block-end: var(--space-6);
    overflow: hidden;
  }

  .heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-block-end: var(--space-6);
    padding-inline: var(--list-gutter);
  }

  .col-headers {
    display: grid;
    grid-template-columns: var(--grid-cols-track);
    gap: var(--space-2);
    padding: var(--space-4) var(--list-gutter) var(--space-1);
    margin-block-end: var(--space-1);
    color: var(--text-muted);
  }

  .col-num {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: right;
    padding-inline-end: var(--space-2);
  }

  .col-title,
  .col-duration {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .col-duration {
    text-align: right;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-1) var(--list-gutter) var(--space-2);
  }

  .track-list {
    display: flex;
    flex-direction: column;
  }

  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-8) var(--list-gutter) var(--space-2);
    color: rgba(255, 255, 255, 0.62);
    text-align: center;
  }

  .coming-soon-art {
    width: 112px;
    height: 84px;
    flex: 0 0 auto;
    color: #66727a;
  }

  .coming-soon-art g {
    stroke-width: 5;
  }

  .coming-soon-art .steam,
  .coming-soon-art .spark {
    stroke-width: 4;
  }

  .coming-soon p {
    font-size: var(--text-base);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .track-list-wrap {
      margin-inline: var(--page-gutter);
      padding-inline: 0;
      padding-block-end: var(--space-6);
    }

    .col-headers {
      grid-template-columns: var(--grid-cols-track-mobile);
    }

    .coming-soon {
      padding-block-start: var(--space-6);
    }

    .coming-soon-art {
      width: 96px;
      height: 72px;
    }
  }
</style>
