---
import TrackRow from './TrackRow.astro';
import { getReadTime } from '../utils/readTime';
import type { Post } from '../types';

type TrackListItem = {
  href: string;
  title: string;
  readTime: number;
  sortDate?: Date | number;
  description?: string;
  active?: boolean;
};

interface Props {
  posts?: Post[];
  tracks?: TrackListItem[];
  pinnedTracks?: TrackListItem[];
  activeSlug?: string;
  heading?: string;
}
const { posts = [], tracks, pinnedTracks = [], activeSlug, heading } = Astro.props;

const timingDataModules = import.meta.glob<{ duration?: number }>(
  ['../content/posts/*.json', '!../content/posts/*.whisper.json'],
  { import: 'default', eager: true }
);

function getPostDuration(post: Post): number {
  const timingData = timingDataModules[`../content/posts/${post.id}.json`];
  return timingData?.duration ? timingData.duration / 60 : getReadTime(post.body ?? '');
}

const trackItems = tracks ?? [
  ...pinnedTracks.map((track) => ({
    ...track,
    sortDate: track.sortDate ?? 0,
  })),
  ...posts.map((post) => ({
    href: `/posts/${post.id}`,
    title: post.data.title,
    readTime: getPostDuration(post),
    sortDate: post.data.date,
    active: post.id === activeSlug,
    description: post.data.description,
  })),
].toSorted((a, b) => {
  const aDate = a.sortDate instanceof Date ? a.sortDate.valueOf() : Number(a.sortDate ?? 0);
  const bDate = b.sortDate instanceof Date ? b.sortDate.valueOf() : Number(b.sortDate ?? 0);
  return bDate - aDate;
});
---

<div class="track-list-wrap">
  <div class="track-list-header">
    {heading && <h1 class="heading">{heading}</h1>}
    <slot name="feature" />
    <div class="col-headers">
      <span class="col-num">#</span>
      <span class="col-title">Title</span>
      <span class="col-duration">Time</span>
    </div>
    <hr class="divider" />
  </div>

  <ul class="track-list">
    {trackItems.map((track, i) => (
      <TrackRow
        index={i + 1}
        title={track.title}
        readTime={track.readTime}
        href={track.href}
        active={track.active}
        description={track.description}
      />
    ))}
  </ul>
</div>

<style>
  .track-list-wrap {
    background: var(--color-feature-surface);
    border: var(--border-width) solid color-mix(in srgb, var(--color-feature-text) 8%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-feature-card);
    margin-inline: var(--page-gutter);
    margin-block-end: var(--space-6);
    padding-inline: var(--list-gutter);
    padding-block-end: var(--space-6);
    overflow: hidden;
  }

  .heading {
    font-size: var(--text-3xl);
    font-weight: 600;
    margin-block-end: var(--space-6);
    padding-inline: var(--list-gutter);
  }

  .col-headers {
    display: grid;
    grid-template-columns: var(--grid-cols-track);
    gap: var(--space-2);
    padding: calc(var(--space-4) + var(--space-4)) var(--list-gutter) var(--space-1);
    margin-block-end: var(--space-1);
    color: var(--color-feature-text-muted);
  }

  .col-num {
    font-size: var(--text-base);
    color: var(--color-feature-text-muted);
    text-align: right;
    padding-inline-end: var(--space-2);
  }

  .col-title,
  .col-duration {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-feature-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .col-duration {
    text-align: right;
  }

  .divider {
    border: none;
    border-top: var(--border-width) solid var(--color-feature-border);
    margin: var(--space-1) var(--list-gutter) var(--space-2);
  }

  .track-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .track-list-wrap {
      margin-inline: 0;
      margin-block-end: 0;
      padding-inline: 0;
      padding-block-end: var(--space-6);
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .col-headers {
      grid-template-columns: var(--grid-cols-track-mobile);
    }
  }
</style>
