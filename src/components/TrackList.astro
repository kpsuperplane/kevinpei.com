---
import TrackRow from './TrackRow.astro';
import { getReadTime } from '../utils/readTime';
import type { Post } from '../types';

type TrackListItem = {
  href: string;
  title: string;
  readTime: number;
  description?: string;
  active?: boolean;
};

interface Props {
  posts: Post[];
  pinnedTracks?: TrackListItem[];
  activeSlug?: string;
  heading?: string;
}
const { posts, pinnedTracks = [], activeSlug, heading } = Astro.props;
const trackOffset = pinnedTracks.length;

const timingDataModules = import.meta.glob<{ duration?: number }>(
  ['../content/posts/*.json', '!../content/posts/*.whisper.json'],
  { import: 'default', eager: true }
);

function getPostDuration(post: Post): number {
  const timingData = timingDataModules[`../content/posts/${post.id}.json`];
  return timingData?.duration ? timingData.duration / 60 : getReadTime(post.body ?? '');
}
---

<div class="track-list-wrap">
  <div class="track-list-header">
    {heading && <h1 class="heading">{heading}</h1>}
    <slot name="feature" />
    <div class="col-headers">
      <span class="col-num">#</span>
      <span class="col-title">Title</span>
      <span class="col-duration">Time</span>
    </div>
    <hr class="divider" />
  </div>

  <ul class="track-list">
    {pinnedTracks.map((track, i) => (
      <TrackRow
        index={i + 1}
        title={track.title}
        readTime={track.readTime}
        href={track.href}
        active={track.active}
        description={track.description}
      />
    ))}
    {posts.map((post, i) => (
      <TrackRow
        index={i + trackOffset + 1}
        title={post.data.title}
        readTime={getPostDuration(post)}
        slug={post.id}
        active={post.id === activeSlug}
        description={post.data.description}
      />
    ))}
  </ul>
</div>

<style>
  .track-list-wrap {
    --text: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.7);
    --border: rgba(255, 255, 255, 0.18);
    background: #15364a;
    border-radius: var(--radius-lg);
    margin-inline: var(--page-gutter);
    padding-inline: var(--list-gutter);
    padding-block-end: var(--space-6);
    overflow: hidden;
  }

  .heading {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-block-end: var(--space-6);
    padding-inline: var(--list-gutter);
  }

  .col-headers {
    display: grid;
    grid-template-columns: var(--grid-cols-track);
    gap: var(--space-2);
    padding: var(--space-4) var(--list-gutter) var(--space-1);
    margin-block-end: var(--space-1);
    color: var(--text-muted);
  }

  .col-num {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: right;
    padding-inline-end: var(--space-2);
  }

  .col-title,
  .col-duration {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .col-duration {
    text-align: right;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-1) var(--list-gutter) var(--space-2);
  }

  .track-list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .track-list-wrap {
      margin-inline: var(--page-gutter);
      padding-inline: 0;
      padding-block-end: var(--space-6);
    }

    .col-headers {
      grid-template-columns: var(--grid-cols-track-mobile);
    }
  }
</style>
