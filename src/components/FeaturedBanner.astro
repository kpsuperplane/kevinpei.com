---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Hey, I'm Kevin.", description } = Astro.props;
---

<a href="/about" class="featured-banner">
  <img class="banner-art" src="/cover.png" alt="Kevin Pei" />
  <div class="banner-content">
    <p class="banner-label">Featured Track</p>
    <h2 class="banner-title">{title}</h2>
  </div>
  {description && <p class="banner-desc">{description}</p>}
</a>

<style>
  .featured-banner {
    display: grid;
    grid-template-columns: 140px 1fr;
    grid-template-rows: auto auto;
    column-gap: 24px;
    padding: 24px 16px 32px;
    background: linear-gradient(to bottom, var(--bg-elevated), var(--bg));
    border-radius: 8px;
    margin: 0 16px 8px;
    transition: filter 0.15s;
  }

  .featured-banner:hover {
    filter: brightness(0.96);
  }

  .banner-art {
    grid-column: 1;
    grid-row: 1 / 3;
    width: 140px;
    height: 140px;
    border-radius: 6px;
    align-self: start;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .banner-content {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-self: start;
  }

  .banner-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .banner-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .banner-desc {
    grid-column: 2;
    grid-row: 2;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    padding-top: 8px;
  }

  @media (max-width: 768px) {
    .featured-banner {
      grid-template-columns: 72px 1fr;
      column-gap: 16px;
      padding: 16px;
      margin: 0 16px 8px;
    }

    .banner-art {
      grid-row: 1;
      width: 72px;
      height: 72px;
      align-self: start;
    }

    .banner-content {
      align-self: center;
    }

    .banner-desc {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .banner-title {
      font-size: 22px;
    }
  }
</style>
