---
interface Props {
  title?: string;
  description?: string;
  image?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
    sources?: {
      mobile?: string;
      desktop?: string;
    };
  };
}
const {
  title = "Hey, I'm Kevin.",
  description,
  image = {
    src: '/cover.png',
    alt: 'Kevin Pei',
    width: 140,
    height: 140,
    sources: {
      mobile: '/cover-144.png',
      desktop: '/cover-280.png',
    },
  },
} = Astro.props;

const imageWidth = image.width ?? 140;
const imageHeight = image.height ?? imageWidth;
---

<a href="/about" class="featured-banner">
  <picture class="banner-art-wrap">
    <source media="(max-width: 768px)" srcset={image.sources?.mobile ?? image.src} />
    <source srcset={image.sources?.desktop ?? image.src} />
    <img
      class="banner-art"
      src={image.src}
      alt={image.alt}
      width={imageWidth}
      height={imageHeight}
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="banner-content">
    <p class="banner-label">Featured Track</p>
    <h2 class="banner-title">{title}</h2>
  </div>
  {description && <p class="banner-desc">{description}</p>}
</a>

<style>
  .featured-banner {
    display: grid;
    grid-template-columns: 140px 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-6);
    padding: var(--space-6) var(--list-gutter) var(--space-8);
    background: linear-gradient(to bottom, var(--bg-elevated), var(--bg));
    border-radius: var(--radius-lg);
    margin: 0 var(--list-gutter) var(--space-2);
    transition: filter 0.15s;
  }

  .featured-banner:hover {
    filter: brightness(0.96);
  }

  .banner-art-wrap {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: start;
  }

  .banner-art {
    width: 140px;
    height: 140px;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    display: block;
  }

  .banner-content {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-self: start;
  }

  .banner-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .banner-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .banner-desc {
    grid-column: 2;
    grid-row: 2;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.5;
    padding-block-start: var(--space-2);
  }

  @media (max-width: 768px) {
    .featured-banner {
      grid-template-columns: 72px 1fr;
      column-gap: var(--space-4);
      padding: var(--space-4);
      margin: 0 var(--list-gutter) var(--space-2);
    }

    .banner-art-wrap {
      grid-row: 1;
    }

    .banner-art {
      width: 72px;
      height: 72px;
    }

    .banner-content {
      align-self: center;
    }

    .banner-desc {
      grid-column: 1 / 3;
      grid-row: 2;
    }

    .banner-title {
      font-size: 22px;
    }
  }
</style>
