---
interface Props {
  title?: string;
  playing?: boolean;
}
const { title = 'Kevin Pei', playing = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-playing={playing ? 'true' : undefined}>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:            #ffffff;
    --bg-elevated:   #f6f6f6;
    --bg-hover:      #efefef;
    --bg-selected:   #e8e8e8;
    --border:        #e0e0e0;
    --text:          #111111;
    --text-muted:    #767676;
    --accent:        #1db954;
    --nowplaying-h:  90px;
    --sidebar-w:     260px;
    --font:          -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono:     'SFMono-Regular', Consolas, monospace;
  }

  html {
    height: 100%;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-rows: 1fr var(--nowplaying-h);
    grid-template-areas:
      "sidebar main"
      "nowplaying nowplaying";
    height: 100%;
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  ul, ol {
    list-style: none;
  }

  @media (max-width: 768px) {
    body {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr var(--nowplaying-h);
      grid-template-areas:
        "main"
        "nowplaying";
    }
  }
</style>
