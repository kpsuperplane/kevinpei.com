---
import Sidebar from '../components/Sidebar.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ClientRouter from 'astro/components/ClientRouter.astro';
import { absoluteUrl, SITE } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  playing?: boolean;
  showNowPlaying?: boolean;
  nowPlayingTitle?: string;
  prevSlug?: string;
  nextSlug?: string;
  firstHref?: string;
  readTime?: number;
  audioSrc?: string | null;
  timingSrc?: string | null;
}

const {
  title = 'Kevin Pei',
  description = SITE.description,
  image = SITE.image,
  type = 'website',
  publishedDate,
  playing = false,
  showNowPlaying = true,
  nowPlayingTitle,
  prevSlug,
  nextSlug,
  firstHref,
  readTime,
  audioSrc,
  timingSrc,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = absoluteUrl(currentPath);
const imageUrl = absoluteUrl(image);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body
    data-playing={playing ? 'true' : undefined}
    data-nowplaying={showNowPlaying ? 'true' : undefined}
    data-readtime={readTime != null ? String(readTime) : undefined}
  >
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="layout">
      <Sidebar currentPath={currentPath} />
      <main id="main" class="main-panel">
        <slot />
      </main>
    </div>
    {showNowPlaying && (
      <NowPlaying
        title={nowPlayingTitle}
        prevSlug={prevSlug}
        nextSlug={nextSlug}
        active={playing}
        firstHref={firstHref}
        audioSrc={audioSrc ?? undefined}
        timingSrc={timingSrc ?? undefined}
      />
    )}
  </body>
</html>

<style is:global>
  /* Disable default crossfade — keep instant client-side navigation */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /* Mobile nav gets its own compositing group above NowPlaying's shadow */
  ::view-transition-group(mobile-nav) {
    z-index: 110; /* matches --z-mobile-nav; vars don't resolve in pseudo-elements */
  }
  ::view-transition-old(mobile-nav) {
    display: none;
  }
  ::view-transition-new(mobile-nav) {
    animation: none;
    opacity: 1;
  }


  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:            #ffffff;
    --bg-elevated:   #f6f6f6;
    --bg-hover:      #efefef;
    --bg-selected:   #e8e8e8;
    --border:        #e0e0e0;
    --text:          #111111;
    --text-muted:    #5a5a5a;
    --accent:        #1db954;
    --nowplaying-h:  90px;
    --sidebar-w:     220px;
    --mobile-nav-h:    56px;
    --mobile-header-h: 56px;
    --content-w:     720px;
    --font:          -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono:     'SFMono-Regular', Consolas, monospace;

    /* Spacing scale */
    --space-1:   4px;
    --space-1-5: 6px;
    --space-2:   8px;
    --space-2-5: 10px;
    --space-3:   12px;
    --space-4:   16px;
    --space-5:   20px;
    --space-6:   24px;
    --space-8:   32px;
    --space-10:  40px;

    /* Radius scale */
    --radius-sm:     4px;
    --radius-md:     6px;
    --radius-lg:     8px;
    --radius-avatar: 10px;

    --page-gutter: var(--space-8);
    --list-gutter: var(--space-4);

    /* Typography scale */
    --text-xs:   11px;
    --text-sm:   12px;
    --text-base: 13px;
    --text-md:   14px;
    --text-lg:   16px;
    --text-xl:   22px;
    --text-2xl:  28px;
    --text-4xl:  42px;

    /* Z-index scale */
    --z-nowplaying: 100;
    --z-sheet:      105;
    --z-mobile-nav: 110;

    /* Track grid */
    --grid-cols-track:        40px 1fr 60px;
    --grid-cols-track-mobile: 32px 1fr 50px;
  }

  html {
    scroll-behavior: smooth;
    touch-action: manipulation;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    overscroll-behavior: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  ul, ol {
    list-style: none;
  }

  /* Reusable utility */
  .truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Visually hidden but available to screen readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Skip link — hidden until focused */
  .skip-link {
    position: absolute;
    top: -40px;
    left: var(--space-2);
    background: var(--text);
    color: var(--bg);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: 600;
    z-index: 1000;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: var(--space-2);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Keyboard focus indicator on all interactive elements */
  button:focus-visible,
  a:focus-visible,
  [role='button']:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar main";
    max-width: calc(var(--sidebar-w) + var(--content-w));
    margin: 0 auto;
  }

  .main-panel {
    grid-area: main;
    background: var(--bg);
    padding-block-start: var(--space-8);
    padding-block-end: calc(var(--nowplaying-h) + var(--space-10));
  }

  body:not([data-nowplaying]) .main-panel {
    padding-block-end: var(--space-10);
  }

  @media (max-width: 768px) {
    :root {
      --page-gutter: var(--space-4);
    }

    .layout {
      grid-template-columns: 1fr;
      grid-template-areas: "main";
      max-width: 100%;
    }

    .main-panel {
      padding-block-start: calc(var(--mobile-header-h) + var(--space-4));
      padding-block-end: calc(var(--nowplaying-h) + var(--mobile-nav-h) + var(--space-6));
    }

    body:not([data-nowplaying]) .main-panel {
      padding-block-end: calc(var(--mobile-nav-h) + var(--space-6));
    }
  }
</style>
