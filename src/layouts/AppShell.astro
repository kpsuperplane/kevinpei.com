---
import Sidebar from '../components/Sidebar.astro';
import NowPlaying from '../components/NowPlaying.astro';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  playing?: boolean;
  nowPlayingTitle?: string;
  nowPlayingTags?: string[];
  prevSlug?: string;
  nextSlug?: string;
}

const {
  title = 'Kevin Pei',
  playing = false,
  nowPlayingTitle,
  nowPlayingTags,
  prevSlug,
  nextSlug,
} = Astro.props;

const allPosts = await getCollection('posts');
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body data-playing={playing ? 'true' : undefined}>
    <div class="layout">
      <Sidebar currentPath={currentPath} tags={tags} />
      <main class="main-panel">
        <slot />
      </main>
    </div>
    <NowPlaying
      title={nowPlayingTitle}
      tags={nowPlayingTags}
      prevSlug={prevSlug}
      nextSlug={nextSlug}
      active={playing}
    />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:            #ffffff;
    --bg-elevated:   #f6f6f6;
    --bg-hover:      #efefef;
    --bg-selected:   #e8e8e8;
    --border:        #e0e0e0;
    --text:          #111111;
    --text-muted:    #767676;
    --accent:        #1db954;
    --nowplaying-h:  90px;
    --sidebar-w:     260px;
    --mobile-nav-h:  56px;
    --content-w:     760px;
    --font:          -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono:     'SFMono-Regular', Consolas, monospace;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  ul, ol {
    list-style: none;
  }

  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar main";
    max-width: calc(var(--sidebar-w) + var(--content-w));
    margin: 0 auto;
  }

  .main-panel {
    grid-area: main;
    background: var(--bg);
    padding-top: 32px;
    padding-bottom: calc(var(--nowplaying-h) + 40px);
  }

  @media (max-width: 768px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-areas: "main";
      max-width: 100%;
    }

    .main-panel {
      padding-bottom: calc(var(--nowplaying-h) + var(--mobile-nav-h) + 24px);
    }
  }
</style>
