---
import Sidebar from '../components/Sidebar.astro';
import NowPlaying from '../components/NowPlaying.astro';
import { getCollection } from 'astro:content';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
  title?: string;
  playing?: boolean;
  nowPlayingTitle?: string;
  nowPlayingTags?: string[];
  prevSlug?: string;
  nextSlug?: string;
  firstHref?: string;
  readTime?: number;
}

const {
  title = 'Kevin Pei',
  playing = false,
  nowPlayingTitle,
  nowPlayingTags,
  prevSlug,
  nextSlug,
  firstHref,
  readTime,
} = Astro.props;

const allPosts = await getCollection('posts');
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body data-playing={playing ? 'true' : undefined} data-readtime={readTime != null ? String(readTime) : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="layout">
      <Sidebar currentPath={currentPath} tags={tags} />
      <main id="main" class="main-panel">
        <slot />
      </main>
    </div>
    <NowPlaying
      title={nowPlayingTitle}
      tags={nowPlayingTags}
      prevSlug={prevSlug}
      nextSlug={nextSlug}
      active={playing}
      firstHref={firstHref}
    />
  </body>
</html>

<style is:global>
  /* Disable default crossfade — keep instant client-side navigation */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /* Keep NowPlaying in its own transition slot so backdrop-filter stays live.
     Hide the outgoing snapshot so only the live element is visible.
     Clamp the group's z-index so it doesn't float above the mobile nav. */
  ::view-transition-group(nowplaying) {
    z-index: 100; /* matches --z-nowplaying; vars don't resolve in pseudo-elements */
  }
  ::view-transition-old(nowplaying) {
    display: none;
  }
  ::view-transition-new(nowplaying) {
    animation: none;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg:            #ffffff;
    --bg-elevated:   #f6f6f6;
    --bg-hover:      #efefef;
    --bg-selected:   #e8e8e8;
    --border:        #e0e0e0;
    --text:          #111111;
    --text-muted:    #5a5a5a;
    --accent:        #1db954;
    --nowplaying-h:  90px;
    --sidebar-w:     260px;
    --mobile-nav-h:    56px;
    --mobile-header-h: 56px;
    --content-w:     760px;
    --font:          -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono:     'SFMono-Regular', Consolas, monospace;

    /* Typography scale */
    --text-xs:   11px;
    --text-sm:   12px;
    --text-base: 13px;
    --text-md:   14px;
    --text-lg:   16px;
    --text-xl:   22px;
    --text-2xl:  28px;
    --text-4xl:  42px;

    /* Z-index scale */
    --z-nowplaying: 100;
    --z-sheet:      105;
    --z-mobile-nav: 110;

    /* Track grid */
    --grid-cols-track:        40px 1fr 120px 60px;
    --grid-cols-track-mobile: 32px 1fr 50px;
  }

  html {
    scroll-behavior: smooth;
    touch-action: manipulation;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    overscroll-behavior: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  ul, ol {
    list-style: none;
  }

  /* Reusable utility */
  .truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Visually hidden but available to screen readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Skip link — hidden until focused */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 8px;
    background: var(--text);
    color: var(--bg);
    padding: 8px 12px;
    border-radius: 6px;
    font-size: var(--text-base);
    font-weight: 600;
    z-index: 1000;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 8px;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Keyboard focus indicator on all interactive elements */
  button:focus-visible,
  a:focus-visible,
  [role='button']:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar main";
    max-width: calc(var(--sidebar-w) + var(--content-w));
    margin: 0 auto;
  }

  .main-panel {
    grid-area: main;
    background: var(--bg);
    padding-top: 32px;
    padding-bottom: calc(var(--nowplaying-h) + 40px);
  }

  @media (max-width: 768px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-areas: "main";
      max-width: 100%;
    }

    .main-panel {
      padding-top: calc(var(--mobile-header-h) + 16px);
      padding-bottom: calc(var(--nowplaying-h) + var(--mobile-nav-h) + 24px);
    }
  }
</style>
