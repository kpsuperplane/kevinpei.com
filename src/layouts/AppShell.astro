---
import Sidebar from '../components/Sidebar.astro';
import NowPlaying from '../components/NowPlaying.astro';
import SecondaryBar from '../components/SecondaryBar.astro';
import geistSerifUrl from '../assets/fonts/geist/GeistSerif-Regular.woff2?url';
import { absoluteUrl, SITE } from '../utils/site';
import '@phosphor-icons/web/fill';
import sourceSansUrl from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@phosphor-icons/web/bold';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  publishedDate?: Date;
  playing?: boolean;
  showNowPlaying?: boolean;
  nowPlayingTitle?: string;
  firstHref?: string;
  readTime?: number;
  audioSrc?: string | null;
  timingSrc?: string | null;
  flushTop?: boolean;
}

const {
  title = 'Kevin Pei',
  description = SITE.description,
  image = SITE.image,
  type = 'website',
  publishedDate,
  playing = false,
  showNowPlaying = true,
  nowPlayingTitle,
  firstHref,
  readTime,
  audioSrc,
  timingSrc,
  flushTop = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = absoluteUrl(currentPath);
const fallbackImagePath = `/og${currentPath.replace(/\/$/, '')}.png`;
const imageUrl = absoluteUrl(image ?? fallbackImagePath);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={sourceSansUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={geistSerifUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>
      if (document.fonts && CSS.registerProperty && CSS.supports('-webkit-text-fill-color', 'color-mix(in srgb, currentColor, transparent)')) {
        const root = document.documentElement;
        root.dataset.fontReveal = 'waiting';

        const reveal = () => delete root.dataset.fontReveal;
        const failsafe = setTimeout(reveal, 3000);

        document.addEventListener('DOMContentLoaded', async () => {
          clearTimeout(failsafe);
          if (root.dataset.fontReveal !== 'waiting') return;

          const fonts = ['400 1em "Geist Serif"', '400 1em "Source Sans 3 Variable"'];
          const sample = 'Let’s build awesome';
          const timeout = setTimeout(reveal, 750);
          let waitedForFrame = false;
          const frame = requestAnimationFrame(() => { waitedForFrame = true; });

          try {
            await Promise.all(fonts.map((font) => document.fonts.load(font, sample)));
          } catch {
            reveal();
          } finally {
            clearTimeout(timeout);
            cancelAnimationFrame(frame);
          }

          if (root.dataset.fontReveal !== 'waiting') return;
          if (!waitedForFrame || matchMedia('(prefers-reduced-motion: reduce)').matches) {
            reveal();
            return;
          }

          root.dataset.fontReveal = 'fading';
          const fade = root.getAnimations().find((animation) => animation.animationName === 'font-text-in');
          if (fade) fade.finished.then(reveal, reveal);
          else reveal();
        }, { once: true });
      }
    </script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    <slot name="head" />
  </head>
  <body
    data-playing={playing ? 'true' : undefined}
    data-nowplaying={showNowPlaying ? 'true' : undefined}
    data-readtime={readTime != null ? String(readTime) : undefined}
    data-flush-top={flushTop ? 'true' : undefined}
  >
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="layout">
      <Sidebar currentPath={currentPath} />
      <main id="main" class="main-panel">
        <slot />
      </main>
    </div>
    <div class="bottom-edge-fill" aria-hidden="true"></div>
    <SecondaryBar hasNowPlaying={showNowPlaying}>
      {showNowPlaying && (
        <NowPlaying
          title={nowPlayingTitle}
          active={playing}
          firstHref={firstHref}
          audioSrc={audioSrc ?? undefined}
          timingSrc={timingSrc ?? undefined}
        />
      )}
    </SecondaryBar>
  </body>
</html>

<script>
  import { initHoverHighlights } from '../utils/hoverHighlight';

  initHoverHighlights();
</script>

<style is:global>
  @property --font-reveal-opacity {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  html[data-font-reveal] body {
    -webkit-text-fill-color: color-mix(in srgb, currentColor calc(var(--font-reveal-opacity) * 100%), transparent);
  }

  html[data-font-reveal='waiting'] {
    --font-reveal-opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html[data-font-reveal='fading'] {
      animation: font-text-in var(--duration-base) var(--ease-out);
    }
  }

  @keyframes font-text-in {
    from { --font-reveal-opacity: 0; }
    to { --font-reveal-opacity: 1; }
  }

  @font-face {
    font-family: 'Geist Serif';
    src: url('../assets/fonts/geist/GeistSerif-Regular.woff2') format('woff2');
    font-display: swap;
  }

  /* Tune fallback metrics against the site's headings and body copy. */
  @font-face {
    font-family: 'Geist Serif Fallback';
    src: local('Georgia');
    size-adjust: 102.7%;
    ascent-override: 97.86%;
    descent-override: 28.72%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Source Sans Fallback';
    src: local('Arial'), local('ArialMT'), local('Liberation Sans');
    font-weight: 100 500;
    size-adjust: 93.7%;
    ascent-override: 109.28%;
    descent-override: 42.69%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Source Sans Fallback';
    src: local('Arial Bold'), local('Arial-BoldMT'), local('Liberation Sans Bold');
    font-weight: 600 900;
    size-adjust: 89.4%;
    ascent-override: 114.54%;
    descent-override: 44.74%;
    line-gap-override: 0%;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    corner-shape: var(--corner-shape);
  }

  :root {
    /* Core colors */
    --color-canvas:          #ffffff;
    --color-surface:         #f6f6f6;
    --color-surface-hover:   #efefef;
    --color-surface-selected: #e8e8e8;
    --color-border:          #e0e0e0;
    --color-text:            #111111;
    --color-text-muted:      #5a5a5a;
    --color-accent:          #1db954;
    --color-accent-text:     #147a37;
    --color-on-strong:       #ffffff;
    --color-overlay:         rgb(0 0 0 / 20%);

    /* Content colors */
    --color-link:            #333333;
    --color-link-underline:  #b8b8b8;
    --color-code-surface:    #f6f8fa;
    --color-code-border:     #d0d7de;
    --color-data-past:       #d8d8d8;
    --color-alert-note:      #0969da;
    --color-alert-tip:       #1a7f37;
    --color-alert-important: #8250df;
    --color-alert-warning:   #9a6700;
    --color-alert-caution:   #cf222e;

    /* Home feature theme */
    --color-feature-surface:     #ffffff;
    --color-feature-text:        #17242d;
    --color-feature-text-muted:  rgb(23 36 45 / 65%);
    --color-feature-border:      rgb(23 36 45 / 14%);
    --color-feature-hover:       rgb(23 36 45 / 7%);
    --color-feature-selected:    rgb(23 36 45 / 9%);

    /* Typography */
    --font-sans: 'Source Sans 3 Variable', 'Source Sans Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-heading: 'Geist Serif', 'Geist Serif Fallback', Georgia, serif;
    --font-mono: 'SFMono-Regular', Consolas, monospace;

    --text-base: 14px;
    --text-md:   14.5px;
    --text-lg:   16.5px;
    --text-xl:   18.5px;
    --text-2xl:  23px;
    --text-3xl:  29px;
    --text-4xl:  33px;
    --text-5xl:  37.5px;
    --text-7xl:  56px;

    --leading-display: 1.01;
    --leading-tight:   1.1;
    --leading-heading: 1.16;
    --leading-snug:    1.3;
    --leading-normal:  1.45;
    --leading-relaxed: 1.65;

    --tracking-wide:   0.06em;
    --tracking-wider:  0.08em;
    --text-wrap-prose: pretty;

    /* Spacing scale */
    --space-px:  1px;
    --space-0-5: 2px;
    --space-1:   4px;
    --space-1-5: 6px;
    --space-2:   8px;
    --space-2-5: 10px;
    --space-3:   12px;
    --space-4:   16px;
    --space-5:   20px;
    --space-6:   24px;
    --space-8:   32px;
    --space-10:  40px;

    /* Radius scale */
    --corner-shape: squircle;
    /* Circular fallbacks use 60% of the squircle radius for an optical match. */
    --radius-s:    14.4px;
    --radius-m:    21.6px;
    --radius-lg:   28.8px;
    --radius-pill: 999px;

    /* Borders, elevation, and motion */
    --border-width: 1px;
    --focus-ring-width: 2px;
    --shadow-floating:
      0 18px 48px rgb(0 0 0 / 12%),
      0 2px 6px rgb(0 0 0 / 6%);
    --shadow-mobile-dock:
      0 0px var(--mobile-dock-bottom) rgb(0 0 0 / 7%),
      0 1px 2px rgb(0 0 0 / 4%);
    --shadow-feature-action:       0 10px 28px rgb(0 0 0 / 18%);
    --shadow-feature-action-hover: 0 14px 34px rgb(0 0 0 / 22%);
    --shadow-feature-text:         0 1px 20px rgb(255 255 255 / 72%);
    --shadow-feature-card:
      0 1px 2px rgb(23 36 45 / 4%),
      0 10px 28px rgb(23 36 45 / 6%);
    --shadow-accent-glow:          2px 0 8px rgb(29 185 84 / 60%);

    --duration-fast: 100ms;
    --duration-base: 150ms;
    --duration-slow: 200ms;
    --ease-standard: ease;
    --ease-out: ease-out;

    /* Control and layout sizes */
    --control-size-sm: 40px;
    --control-size-md: 44px;
    --nowplaying-h: 64px;
    --nowplaying-bottom: var(--space-5);
    --sidebar-w: 220px;
    --mobile-nav-h: 56px;
    --mobile-dock-bottom: max(var(--space-3), env(safe-area-inset-bottom));
    --safe-area-inset-top: env(safe-area-inset-top, 0px);
    --safe-area-inset-left: env(safe-area-inset-left, 0px);
    --safe-area-inset-right: env(safe-area-inset-right, 0px);
    --mobile-player-extension: var(--space-6);
    --content-w: 720px;

    --page-gutter: var(--space-8);
    --list-gutter: var(--space-4);

    /* Z-index scale */
    --z-nowplaying: 100;
    --z-mobile-nav: 105;

    /* Track grid */
    --grid-cols-track:        24px 1fr 60px;
    --grid-cols-track-mobile: 32px 1fr 50px;
  }

  /* iOS safari shenanigans */
  @supports (hanging-punctuation: first) and (font: -apple-system-body) and (-webkit-touch-callout: none) {
    :root {
      --mobile-dock-bottom: max(var(--space-2), env(safe-area-inset-bottom));
    }
  }

  @supports (corner-shape: squircle) {
    :root {
      --radius-s:  24px;
      --radius-m:  36px;
      --radius-lg: 48px;
    }
  }

  @supports (font: -apple-system-body) {
    :root {
      --text-wrap-prose: wrap;
    }
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-behavior: smooth;
    touch-action: manipulation;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background: var(--color-canvas);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    overscroll-behavior: none;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-synthesis-weight: none;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  [data-hover-group] {
    position: relative;
    isolation: isolate;
  }

  [data-hover-group]::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    pointer-events: none;
    width: var(--hover-width, 0px);
    height: var(--hover-height, 0px);
    border-radius: var(--hover-highlight-radius);
    background: var(--hover-highlight-color);
    opacity: 0;
    transform: translate(var(--hover-x, 0px), var(--hover-y, 0px));
  }

  [data-hover-active] {
    --item-hover-background: transparent;
  }

  [data-hover-active]::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-hover-group]::before {
      transition: opacity var(--duration-fast) var(--ease-out);
    }

    [data-hover-slide]::before {
      --hover-slide-ease: cubic-bezier(0.2, 0.75, 0.35, 1);
      transition:
        opacity var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--hover-slide-ease),
        width var(--duration-fast) var(--hover-slide-ease),
        height var(--duration-fast) var(--hover-slide-ease);
    }

    @supports (transition-timing-function: linear(0, 1)) {
      [data-hover-slide]::before {
        /* Critically damped response: 1 - (1 + 7t)e^(-7t), normalized at t = 1. */
        --hover-slide-ease: linear(
          0, 0.072, 0.220, 0.380, 0.526, 0.647, 0.743, 0.816, 0.870,
          0.910, 0.939, 0.960, 0.974, 0.985, 0.992, 0.997, 1
        );
      }
    }
  }

  ul, ol {
    list-style: none;
  }

  /* Reusable utility */
  .truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Visually hidden but available to screen readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Skip link — hidden until focused */
  .skip-link {
    position: absolute;
    top: -40px;
    left: max(var(--space-2), var(--safe-area-inset-left));
    background: var(--color-text);
    color: var(--color-canvas);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-s);
    font-size: var(--text-base);
    font-weight: 700;
    z-index: 1000;
    transition: top var(--duration-base) var(--ease-standard);
  }
  .skip-link:focus {
    top: max(var(--space-2), var(--safe-area-inset-top));
    outline: var(--focus-ring-width) solid var(--color-accent-text);
    outline-offset: 2px;
  }

  /* Keyboard focus indicator on all interactive elements */
  button:focus-visible,
  a:focus-visible,
  [role='button']:focus-visible,
  input:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent-text);
    outline-offset: 2px;
    border-radius: var(--radius-s);
  }

  .layout {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-areas: "sidebar main";
    width: 100%;
    max-width: calc(
      var(--sidebar-w) +
      var(--content-w) +
      var(--safe-area-inset-left) +
      var(--safe-area-inset-right)
    );
    margin: 0 auto;
    padding-inline-start: var(--safe-area-inset-left);
    padding-inline-end: var(--safe-area-inset-right);
  }

  .main-panel {
    grid-area: main;
    min-width: 0;
    background: var(--color-canvas);
    padding-inline: var(--page-gutter);
    padding-block-start: calc(var(--space-8) + var(--safe-area-inset-top));
    padding-block-end: calc(var(--nowplaying-h) + var(--space-10));
  }

  body:not([data-nowplaying]) .main-panel {
    padding-block-end: var(--space-10);
  }

  .bottom-edge-fill {
    --bottom-edge-bar-height: var(--nowplaying-h);
    display: none;
    position: fixed;
    inset: auto 0 0;
    height: calc(var(--nowplaying-bottom) + var(--bottom-edge-bar-height));
    z-index: calc(var(--z-nowplaying) - 1);
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--color-canvas) calc(var(--bottom-edge-bar-height) / 2));
  }

  body[data-nowplaying] .bottom-edge-fill {
    display: block;
  }

  @media (min-width: 769px) {
    body[data-flush-top] .main-panel {
      padding-block-start: var(--safe-area-inset-top);
    }
  }

  @media (max-width: 480px) {
    html,
    body {
      overflow-x: clip;
    }

    :root {
      --page-gutter: var(--space-4);
    }

    .bottom-edge-fill {
      --bottom-edge-bar-height: var(--mobile-nav-h);
      display: block;
      height: calc(var(--mobile-dock-bottom) + var(--bottom-edge-bar-height));
    }

    .layout {
      grid-template-columns: 1fr;
      grid-template-areas: "main";
      max-width: 100%;
    }

    .main-panel {
      padding-block-start: calc(var(--space-4) + var(--safe-area-inset-top));
      padding-block-end: calc(
        var(--nowplaying-h) +
        var(--mobile-player-extension) +
        (var(--mobile-nav-h) / 2) +
        var(--mobile-dock-bottom) +
        var(--space-6)
      );
    }

    body:not([data-nowplaying]) .main-panel {
      padding-block-end: calc(
        var(--mobile-nav-h) +
        var(--mobile-dock-bottom) +
        var(--space-6)
      );
    }
  }

  @media (max-width: 480px) {
    body[data-flush-top] .main-panel {
      padding-block-start: var(--safe-area-inset-top);
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    :root {
      --sidebar-w: 96px;
      --page-gutter: var(--space-4);
    }

    .main-panel {
      padding-block-start: var(--space-4);
    }

    body[data-flush-top] .main-panel {
      padding-block-start: 0;
    }
  }
</style>
