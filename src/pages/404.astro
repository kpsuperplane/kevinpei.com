---
import AppShell from '../layouts/AppShell.astro';
---

<AppShell
  title="Page Not Found — Kevin Pei"
  description="This page is not available on Kevin Pei's website."
  showNowPlaying={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404</p>
    <h1 id="not-found-title">This track is not on the album.</h1>
    <p>
      The page may have moved, or it may still be waiting for a future release.
    </p>
    <div class="actions">
      <a class="primary-link" href="/">Back to the album</a>
      <a href="/about">About Me</a>
    </div>
  </section>
</AppShell>

<style>
  .not-found {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-10) var(--page-gutter);
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 560px;
    color: var(--text);
    font-size: 34px;
    line-height: 1.16;
  }

  p {
    max-width: 520px;
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .actions a {
    color: var(--text);
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-5);
    border-radius: 999px;
    background: var(--text);
    color: var(--bg) !important;
  }

  @media (max-width: 768px) {
    .not-found {
      min-height: 54vh;
      padding-block: var(--space-8);
    }

    h1 {
      font-size: 28px;
    }
  }
</style>
