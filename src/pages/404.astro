---
import AppShell from '../layouts/AppShell.astro';
---

<AppShell
  title="Page Not Found — Kevin Pei"
  description="This page is not available on Kevin Pei's website."
  showNowPlaying={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404</p>
    <h1 id="not-found-title">This track is not on the album.</h1>
    <p>
      The page may have moved, or it may still be waiting for a future release.
    </p>
    <div class="actions">
      <a class="primary-link" href="/">Back to the album</a>
      <a href="/about">About Me</a>
    </div>
  </section>
</AppShell>

<style>
  .not-found {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-10) var(--page-gutter);
  }

  .eyebrow {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  h1 {
    max-width: 560px;
    color: var(--color-text);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
  }

  p {
    max-width: 520px;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    text-wrap: var(--text-wrap-prose);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-2);
    font-size: var(--text-md);
    font-weight: 700;
  }

  .actions a {
    color: var(--color-text);
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size-sm);
    padding: 0 var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-canvas) !important;
  }

  @media (max-width: 768px) {
    .not-found {
      min-height: 54vh;
      padding-block: var(--space-8);
    }

    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
