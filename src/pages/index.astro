---
import AppShell from '../layouts/AppShell.astro';
import TrackList from '../components/TrackList.astro';
import FeaturedBanner from '../components/FeaturedBanner.astro';
import { getCollection } from 'astro:content';
import { frontmatter as aboutFrontmatter } from '../content/about.md';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<AppShell title="Kevin Pei" description={aboutFrontmatter.description} firstHref="/about">
  <TrackList heading="Now Streaming" posts={posts}>
    <FeaturedBanner slot="feature" title={aboutFrontmatter.title} description={aboutFrontmatter.description} />
  </TrackList>
</AppShell>
