---
import AppShell from '../layouts/AppShell.astro';
import TrackList from '../components/TrackList.astro';
import AlbumHeader from '../components/AlbumHeader.astro';
import { getCollection } from 'astro:content';
import { frontmatter as aboutFrontmatter } from '../content/about.mdx';
import aboutTimingData from '../content/about.json';

const albumTitle = "Hey, I'm Kevin.";
const albumDescription = "From mountain trails to pixel-perfect interfaces, Kevin's debut album features tracks on UX craft, engineering philosophy, and the quiet joy of a good powder day.";

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const aboutTrack = {
  href: '/about',
  title: aboutFrontmatter.title,
  readTime: aboutTimingData.duration / 60,
  description: aboutFrontmatter.description,
};
---

<AppShell title="Kevin Pei" description={aboutFrontmatter.description} firstHref="/about">
  <TrackList posts={posts} pinnedTracks={[aboutTrack]}>
    <AlbumHeader
      slot="feature"
      title={albumTitle}
      description={albumDescription}
      playHref="/about"
      image={aboutFrontmatter.image}
    />
  </TrackList>
</AppShell>
