---
import AppShell from '../../layouts/AppShell.astro';
import PostView from '../../components/PostView.astro';
import { getCollection, render } from 'astro:content';
import { getReadTime } from '../../utils/readTime';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[i + 1] ?? null,
      nextPost: sorted[i - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const readTime = getReadTime(post.body ?? '');
---

<AppShell
  title={`${post.data.title} — Kevin Pei`}
  playing={true}
  nowPlayingTitle={post.data.title}
  nowPlayingTags={post.data.tags}
  prevSlug={prevPost?.id}
  nextSlug={nextPost?.id}
  readTime={readTime}
>
  <Fragment slot="head">
    <meta name="description" content={post.data.description ?? post.data.title} />
  </Fragment>
  <PostView
    Content={Content}
    title={post.data.title}
    description={post.data.description}
    tags={post.data.tags}
    date={post.data.date}
    readTime={readTime}
  />
</AppShell>

