---
import AppShell from '../../layouts/AppShell.astro';
import PostView from '../../components/PostView.astro';
import { render } from 'astro:content';
import { getReadTime } from '../../utils/readTime';
import { getSortedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const sorted = await getSortedPosts();
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[i + 1] ?? null,
      nextPost: sorted[i - 1] ?? null,
    },
  }));
}

// Detect co-located .m4a files — the audioPlugin Vite plugin handles URL resolution
const audioModules = import.meta.glob<string>(
  '../../content/posts/*.m4a',
  { import: 'default', eager: true }
);
const timingModules = import.meta.glob<string>(
  ['../../content/posts/*.json', '!../../content/posts/*.whisper.json'],
  { query: '?url', import: 'default', eager: true }
);
const timingDataModules = import.meta.glob<{ duration?: number }>(
  ['../../content/posts/*.json', '!../../content/posts/*.whisper.json'],
  { import: 'default', eager: true }
);

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
const readTime = getReadTime(post.body ?? '');

const audioSrc  = audioModules[`../../content/posts/${post.id}.m4a`] ?? null;
const timingSrc = audioSrc ? timingModules[`../../content/posts/${post.id}.json`] ?? null : null;
const timingData = audioSrc ? timingDataModules[`../../content/posts/${post.id}.json`] : null;
const duration = timingData?.duration ? timingData.duration / 60 : readTime;
---

<AppShell
  title={`${post.data.title} — Kevin Pei`}
  description={post.data.description ?? post.data.title}
  image={post.data.image?.src}
  type="article"
  publishedDate={post.data.date}
  playing={true}
  nowPlayingTitle={post.data.title}
  prevSlug={prevPost?.id}
  nextSlug={nextPost?.id}
  readTime={duration}
  audioSrc={audioSrc}
  timingSrc={timingSrc}
>
  <PostView
    Content={Content}
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    readTime={duration}
  />
</AppShell>
