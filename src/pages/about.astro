---
import AppShell from '../layouts/AppShell.astro';
import PostView from '../components/PostView.astro';
import AboutContent, { frontmatter } from '../content/about.mdx';
import aboutAudio from '../content/about.m4a';
import aboutTimingData from '../content/about.json';
import aboutTiming from '../content/about.json?url';

const duration = aboutTimingData.duration / 60;
---

<AppShell
  title="About — Kevin Pei"
  description={frontmatter.description}
  playing={true}
  nowPlayingTitle={frontmatter.title}
  nowPlayingTags={frontmatter.tags}
  readTime={duration}
  audioSrc={aboutAudio}
  timingSrc={aboutTiming}
>
  <PostView
    Content={AboutContent}
    title={frontmatter.title}
    description={frontmatter.description}
    tags={frontmatter.tags}
    linkTags={false}
    readTime={duration}
  />
</AppShell>
