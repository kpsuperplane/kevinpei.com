---
import AppShell from '../layouts/AppShell.astro';
import AboutContent from '../content/about.md';
---

<AppShell title="About — Kevin Pei">
  <div class="about-wrap">
    <p class="label">About</p>
    <div class="body">
      <AboutContent />
    </div>
  </div>
</AppShell>

<style>
  .about-wrap {
    padding: 0px 32px 48px;
  }

  .label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .body {
    font-size: 16px;
    color: var(--text);
    line-height: 1.7;
  }

  .body :global(p) { margin-bottom: 20px; }
  .body :global(h2) { font-size: 22px; font-weight: 600; margin: 36px 0 12px; }
  .body :global(a) { color: var(--accent); text-decoration: underline; text-decoration-color: transparent; transition: text-decoration-color 0.1s; }
  .body :global(a:hover) { text-decoration-color: var(--accent); }
  .body :global(ul), .body :global(ol) { padding-left: 24px; margin-bottom: 20px; list-style: revert; }
  .body :global(li) { margin-bottom: 6px; }
</style>
