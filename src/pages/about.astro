---
import AppShell from '../layouts/AppShell.astro';
import PostView from '../components/PostView.astro';
import AboutContent, { frontmatter } from '../content/about.mdx';
import aboutAudio from '../content/about.m4a';
import aboutTimingData from '../content/about.json';
import aboutTiming from '../content/about.json?url';

const duration = aboutTimingData.duration / 60;
const aboutImage = frontmatter.image?.src;
---

<AppShell
  title="About Me — Kevin Pei"
  description={frontmatter.description}
  image={aboutImage}
  playing={true}
  nowPlayingTitle={frontmatter.title}
  readTime={duration}
  audioSrc={aboutAudio}
  timingSrc={aboutTiming}
>
  <PostView
    Content={AboutContent}
    title={frontmatter.title}
    description={frontmatter.description}
    readTime={duration}
  />
</AppShell>

<style>
  :global(.post-view .post-body > .about-skis) {
    border-radius: 0;
    border-bottom: var(--border-width) solid color-mix(in srgb, var(--color-border) 55%, transparent);
  }
</style>
