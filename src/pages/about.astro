---
import AppShell from '../layouts/AppShell.astro';
import Sidebar from '../components/Sidebar.astro';
import NowPlaying from '../components/NowPlaying.astro';
import { getCollection } from 'astro:content';
import AboutContent from '../content/about.md';

const allPosts = await getCollection('posts');
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();
---

<AppShell title="About — Kevin Pei">
  <Sidebar currentPath="/about" tags={tags} />
  <main class="main-panel">
    <div class="about-wrap">
      <p class="label">About</p>
      <div class="body">
        <AboutContent />
      </div>
    </div>
  </main>
  <NowPlaying />
</AppShell>

<style>
  .main-panel {
    grid-area: main;
    overflow-y: auto;
    background: var(--bg);
  }

  .about-wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 48px 32px;
  }

  .label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .title {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .body {
    font-size: 16px;
    color: var(--text);
    line-height: 1.7;
  }

  .body :global(p) { margin-bottom: 20px; }
  .body :global(h2) { font-size: 22px; font-weight: 600; margin: 36px 0 12px; }
  .body :global(a) { color: var(--accent); text-decoration: underline; text-decoration-color: transparent; transition: text-decoration-color 0.1s; }
  .body :global(a:hover) { text-decoration-color: var(--accent); }
  .body :global(ul), .body :global(ol) { padding-left: 24px; margin-bottom: 20px; list-style: revert; }
  .body :global(li) { margin-bottom: 6px; }
</style>
