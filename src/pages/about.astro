---
import AppShell from '../layouts/AppShell.astro';
import PostView from '../components/PostView.astro';
import AboutContent, { frontmatter } from '../content/about.md';
import aboutRaw from '../content/about.md?raw';
import { getReadTime } from '../utils/readTime';

const readTime = getReadTime(aboutRaw.replace(/^---[\s\S]*?---\n?/, ''));
---

<AppShell
  title="About — Kevin Pei"
  playing={true}
  nowPlayingTitle={frontmatter.title}
  nowPlayingTags={frontmatter.tags}
>
  <PostView
    Content={AboutContent}
    title={frontmatter.title}
    description={frontmatter.description}
    tags={frontmatter.tags}
    readTime={readTime}
  />
</AppShell>

<script define:vars={{ readTime }}>
  document.body.dataset.readtime = String(readTime);
</script>
