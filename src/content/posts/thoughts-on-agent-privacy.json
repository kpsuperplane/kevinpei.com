        318.8,
        319.38,
        319.64,
        319.9,
        320.16,
        320.3,
        320.78,
        321.36
      ]
    },
    {
      "id": "lyric-062-6bcbfc09",
      "text": "Ownership: repositories of personal data that the user unambiguously trusts.",
      "start": 323.16,
      "end": 327.92,
