        276.55,
        276.93,
        277.07,
        277.19,
        277.31,
        277.53,
        277.65,
        277.77,
        278.27
      ]
    },
    {
      "id": "lyric-051-390f33bc",
      "text": "It won\u2019t be perfect, and it won\u2019t be suitable for those who need perfect safety, but it\u2019s a significant reduction in threat scope and in my opinion good enough for most personal agents.",
      "start": 278.87,
      "end": 288.27,
      "words": [
        278.87,
        279.19,
        279.31,
        279.43,
        279.55,
        279.97,
        280.47,
        280.57,
        280.65,
        280.73,
        280.85,
        281.13,
