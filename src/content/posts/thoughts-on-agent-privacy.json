        293.05,
        293.45,
        293.81,
        294.33,
        294.65
      ]
    },
    {
      "id": "lyric-053-6530b661",
      "text": "Example: Broadly scoped judge",
      "start": null,
      "end": null
    },
    {
      "id": "lyric-055-da256d66",
      "text": "Compared to: Narrowly scoped judge",
      "start": null,
      "end": null
    },
    {
      "id": "lyric-057-ce6623c7",
      "text": "So I built Guardian",
      "start": 297.06,
      "end": 298.14,
      "words": [
        297.06,
        297.46,
        297.56,
        297.78,
        298.14
      ]
    },
    {
      "id": "lyric-058-54df50d3",
      "text": "Hermes Guardian is my attempt at building this for personal agents.",
      "start": 299.12,
      "end": 302.5,
      "words": [
        299.12,
        299.52,
        299.86,
        300.22,
        300.34,
        300.68,
        301.12,
        301.32,
        301.54,
        301.7,
        302.06,
        302.5
      ]
    },
    {
      "id": "lyric-059-07f0d15a",
      "text": "At its core is the exact checkpoint described earlier; the agent never talks to a tool without Guardian approving it.",
      "start": 303.22,
      "end": 309.76,
      "words": [
